{
  "name": "cprep-blog",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "prebuild": "node $([ -f .env ] && echo --env-file=.env) scripts/generate-og.mjs && node $([ -f .env ] && echo --env-file=.env) scripts/generate-ig-briefs.mjs",
    "generate-brandkit": "node scripts/generate-brandkit.js",
    "build": "astro build",
    "postbuild": "pagefind --site dist",
    "preview": "astro preview",
    "astro": "astro",
    "studio": "cd studio && sanity dev",
    "studio:build": "cd studio && sanity build",
    "studio:deploy": "cd studio && sanity deploy",
    "migrate:sanity": "node scripts/migrate-to-sanity.mjs",
    "typegen": "cd studio && npx sanity schema extract && npx sanity typegen generate"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.6",
    "@astrojs/mdx": "^4.3.13",
    "@astrojs/rss": "^4.0.15",
    "@astrojs/sitemap": "^3.7.0",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/source-serif-4": "^5.2.9",
    "@resvg/resvg-js": "^2.6.2",
    "@sanity/client": "^7.15.0",
    "@tailwindcss/vite": "^4.1.18",
    "@vercel/analytics": "^1.6.1",
    "@vercel/speed-insights": "^1.3.1",
    "astro": "^5.17.2",
    "gray-matter": "^4.0.3",
    "pagefind": "^1.4.0",
    "rehype-katex": "^7.0.1",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "sanity": "^5.11.0",
    "satori": "^0.19.2",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "vercel": "^50.17.1"
  },
  "devDependencies": {
    "@astrojs/vercel": "^9.0.4",
    "@types/hast": "^3.0.4",
    "@types/node": "^20.0.0",
    "archiver": "^5.3.2",
    "fast-glob": "^3.3.3",
    "katex": "^0.16.28",
    "png-to-ico": "^3.0.1",
    "sharp": "^0.34.5"
  }
}
