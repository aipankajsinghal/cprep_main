---
import '../styles/global.css';
import '../styles/tokens.css';
import '../styles/typography.css';
import '../styles/print.css';
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import InlineQuiz from "../components/InlineQuiz.astro";
import Toast from "../components/Toast.astro";
import SpeedInsights from '@vercel/speed-insights/astro';
import { slugifyTag } from "../utils/content";
import { getClient } from "../lib/sanity";
import { ALL_POSTS_QUERY } from "../lib/queries";

type JsonLdValue = Record<string, unknown>;

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  ogType?: string;
  noindex?: boolean;
  pagefindStyles?: boolean;
  jsonLd?: JsonLdValue | JsonLdValue[];
  gaContext?: Record<string, string>;
  author?: string;
  publishedDate?: string;
  updatedDate?: string;
  articleTags?: string[];
  articleSection?: string;
}

const {
  title = "ChampionsPrep Blog",
  description = "High-performance editorial content for exam preparation.",
  canonical,
  ogImage,
  ogType = "website",
  noindex = false,
  pagefindStyles = false,
  jsonLd = [],
  gaContext = {},
  author,
  publishedDate,
  updatedDate,
  articleTags,
  articleSection,
} = Astro.props as Props;

const pageTitle = title.includes("ChampionsPrep") ? title : `${title} | ChampionsPrep Blog`;
const normalizeCanonical = (value: string): string => {
  const parsed = new URL(value);
  if (!/\.[a-z0-9]+$/i.test(parsed.pathname) && !parsed.pathname.endsWith("/")) {
    parsed.pathname = `${parsed.pathname}/`;
  }
  return parsed.toString();
};
const canonicalUrl = normalizeCanonical(canonical ?? new URL(Astro.url.pathname, Astro.site ?? Astro.url).toString());
const ogImageUrl = ogImage ? new URL(ogImage, Astro.site ?? Astro.url).toString() : undefined;
const jsonLdBlocks = Array.isArray(jsonLd) ? jsonLd : [jsonLd];
const gaMeasurementId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID;
const isPreview = Astro.cookies.has('sanity-preview');
const client = getClient(isPreview);
const navTags = await client.fetch(ALL_POSTS_QUERY).then((posts: any[]) => {
  const counter = new Map<string, { slug: string; label: string; count: number }>();
  for (const post of posts) {
    for (const tag of post.tags ?? []) {
      const slug = slugifyTag(tag);
      const existing = counter.get(slug);
      if (existing) {
        existing.count += 1;
      } else {
        counter.set(slug, { slug, label: tag, count: 1 });
      }
    }
  }
  return Array.from(counter.values())
    .sort((a, b) => b.count - a.count || a.label.localeCompare(b.label))
    .slice(0, 12)
    .map(({ slug, label }) => ({ slug, label }));
});
// Quiz placement helpers
const entryData = (Astro.props as any).entry?.data;
const quizData = entryData?.quiz ? (entryData.quiz as import("../types/global").Quiz | undefined) : undefined;
const hasInlineQuiz = Astro.slots?.has && Astro.slots.has("quiz");
const shouldRenderQuiz = !hasInlineQuiz && quizData && quizData.questions && quizData.questions.length > 0;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#6b5b95" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
    {ogImageUrl && <meta property="og:image:width" content="1200" />}
    {ogImageUrl && <meta property="og:image:height" content="630" />}
    {ogImageUrl && <meta property="og:image:type" content="image/png" />}
    <meta property="og:site_name" content="ChampionsPrep Blog" />
    {ogType === "article" && author && <meta property="article:author" content={author} />}
    {ogType === "article" && publishedDate && <meta property="article:published_time" content={publishedDate} />}
    {ogType === "article" && updatedDate && <meta property="article:modified_time" content={updatedDate} />}
    {ogType === "article" && articleSection && <meta property="article:section" content={articleSection} />}
    {ogType === "article" && articleTags && articleTags.map((tag) => <meta property="article:tag" content={tag} />)}
    {ogType === "article" && author && <meta name="author" content={author} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@championsprep" />
    {ogType === "article" && <meta name="twitter:creator" content="@championsprep" />}
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    {ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="CPrep Blog" />
    <script is:inline>
      (() => {
        const key = "theme";
        let mode = "light";
        try {
          const saved = localStorage.getItem(key);
          if (saved === "light" || saved === "dark") {
            mode = saved;
          } else if (window.matchMedia("(prefers-color-scheme: dark)").matches) {
            mode = "dark";
          }
        } catch {}
        if (mode === "dark") {
          document.documentElement.classList.add("dark");
        }
      })();
    </script>
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="en-IN" href={canonicalUrl} />
    <link rel="alternate" hreflang="en" href={canonicalUrl} />
    <link rel="alternate" hreflang="x-default" href={canonicalUrl} />
    <link rel="alternate" type="application/rss+xml" title="ChampionsPrep Blog" href="/rss.xml" />
    <link rel="preconnect" href="https://cdn.sanity.io" />
    <link rel="dns-prefetch" href="https://cdn.sanity.io" />
    <link rel="manifest" href="/manifest.webmanifest" />
    {pagefindStyles && <link rel="stylesheet" href="/pagefind/pagefind-ui.css" />}
    <link
      rel="preload"
      href="/fonts/inter-latin-400-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <link
      rel="preload"
      href="/fonts/inter-latin-600-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <link
      rel="preload"
      href="/fonts/source-serif-4-latin-600-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <link
      rel="preload"
      href="/fonts/source-serif-4-latin-700-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <link rel="stylesheet" href="/vendor/shareon/shareon.min.css" />
    <script defer is:inline src="/vendor/shareon/shareon.iife.js"></script>
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {jsonLdBlocks.map((block) => (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(block)} />
    ))}
    {gaMeasurementId && (
      <>
        <script async is:inline src={`https://www.googletagmanager.com/gtag/js?id=${gaMeasurementId}`}></script>
        <script is:inline define:vars={{ gaMeasurementId }}>
          window.dataLayer = window.dataLayer || [];
          function gtag() {
            window.dataLayer.push(arguments);
          }
          window.gtag = window.gtag || gtag;
          window.gtag("js", new Date());
          window.gtag("config", gaMeasurementId);
        </script>
      </>
    )}
    <script is:inline define:vars={{ gaContext }}>
      window.__cpGaContext = gaContext;
      window.cpTrack = function (eventName, eventParams) {
        if (typeof window.gtag !== "function") return;
        const merged = Object.assign({}, window.__cpGaContext || {}, eventParams || {});
        window.gtag("event", eventName, merged);
      };
    </script>
    <script is:inline>
      window.addEventListener("DOMContentLoaded", () => {
        if (window.Shareon && typeof window.Shareon.init === "function") {
          window.Shareon.init();
        }
      });
    </script>
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <SiteHeader tags={navTags} />
    <main id="main-content" class="page-shell">
      <article class="editorial" data-pagefind-body>
        <slot />
        <slot name="quiz" />

        {shouldRenderQuiz && (
          <section class="post-quiz-section">
            <InlineQuiz quiz={quizData as import("../types/global").Quiz} />
          </section>
        )}
      </article>
    </main>
    <SiteFooter />
    <Toast />
    <SpeedInsights />
    <button class="scroll-top" type="button" aria-label="Scroll to top" data-scroll-top hidden>
      ↑
    </button>
    <script is:inline>
      (() => {
        const key = "theme";
        const buttons = Array.from(document.querySelectorAll("[data-theme-toggle]")).filter((button) =>
          button instanceof HTMLButtonElement
        );
        if (!buttons.length) return;

        const syncLabel = () => {
          const dark = document.documentElement.classList.contains("dark");
          for (const button of buttons) {
            if (!(button instanceof HTMLButtonElement)) continue;
            button.textContent = dark ? "Light Mode" : "Dark Mode";
          }
        };

        syncLabel();
        for (const button of buttons) {
          if (!(button instanceof HTMLButtonElement)) continue;
          button.addEventListener("click", () => {
            const isDark = document.documentElement.classList.toggle("dark");
            try {
              localStorage.setItem(key, isDark ? "dark" : "light");
            } catch {}
            syncLabel();
          });
        }
      })();
    </script>
    <script is:inline>
      (() => {
        const button = document.querySelector("[data-scroll-top]");
        if (!(button instanceof HTMLButtonElement)) return;

        const onScroll = () => {
          button.hidden = window.scrollY < 420;
        };

        onScroll();
        window.addEventListener("scroll", onScroll, { passive: true });
        button.addEventListener("click", () => {
          window.scrollTo({ top: 0, behavior: "smooth" });
        });
      })();
    </script>
    <script is:inline>
      (() => {
        if (!("serviceWorker" in navigator)) return;
        window.addEventListener("load", () => {
          navigator.serviceWorker.register("/sw.js", { scope: "/" }).catch(() => {});
        });
      })();
    </script>
  </body>
</html>
