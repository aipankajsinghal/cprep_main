---
import { getCollection, type CollectionEntry } from "astro:content";
import BlogLayout from '../../layouts/BlogLayout.astro';
import ExamTip from "../../components/ExamTip.astro";
import RelatedPosts from "../../components/RelatedPosts.astro";
import AuthorCard from "../../components/AuthorCard.astro";
import TableOfContents from "../../components/TableOfContents.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import PrevNextNav from "../../components/PrevNextNav.astro";
import ReadingProgress from "../../components/ReadingProgress.astro";
import ShareButtons from "../../components/ShareButtons.astro";
import MicroFeedback from "../../components/MicroFeedback.astro";
import SmartCTA from "../../components/SmartCTA.astro";
import { calculateMinutesRead } from "../../utils/content";

export function getStaticPaths() {
  return getCollection("blog", ({ data }) => !data.draft).then((posts) =>
    posts.map((entry) => ({
      params: { slug: entry.slug },
      props: { entry }
    }))
  );
}

const { entry } = Astro.props as { entry: CollectionEntry<"blog"> };
const { Content, headings } = await entry.render();
const tocHeadings = headings.filter((item) => item.depth === 2 || item.depth === 3);
const canonical = new URL(`/blog/${entry.slug}/`, Astro.site ?? Astro.url).toString();
const ogImagePath = entry.data.ogImage ?? `/blog/og/${entry.slug}.png`;
const ogImageUrl = new URL(ogImagePath, Astro.site ?? Astro.url).toString();
const minutesRead = entry.data.minutesRead ?? calculateMinutesRead(entry.body);
const pageTitle = entry.data.title;
const pageDescription = entry.data.description;
const allPosts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
const clusterPosts = allPosts.filter((post) => post.data.cluster === entry.data.cluster);
const clusterPostsAscending = [...clusterPosts].sort((a, b) => {
  const byDate = a.data.date.getTime() - b.data.date.getTime();
  return byDate !== 0 ? byDate : a.slug.localeCompare(b.slug);
});
const currentIndex = clusterPosts.findIndex((post) => post.slug === entry.slug);
const previousPost = currentIndex > 0 ? clusterPosts[currentIndex - 1] : undefined;
const nextPost =
  currentIndex >= 0 && currentIndex < clusterPosts.length - 1
    ? clusterPosts[currentIndex + 1]
    : undefined;
const blogPostingJsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: entry.data.title,
  description: entry.data.description,
  datePublished: entry.data.date.toISOString(),
  dateModified: (entry.data.updatedDate ?? entry.data.date).toISOString(),
  image: ogImageUrl,
  author: {
    "@type": "Person",
    name: entry.data.author
  },
  mainEntityOfPage: canonical,
  url: canonical
};
const learningResourceJsonLd = {
  "@context": "https://schema.org",
  "@type": "LearningResource",
  learningResourceType: "Lesson",
  educationalLevel: "Class 11-12",
  teaches: entry.data.cluster,
  name: entry.data.title,
  description: entry.data.description,
  url: canonical
};
const learningPathJsonLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: `${entry.data.cluster} Learning Path`,
  itemListOrder: "https://schema.org/ItemListOrderAscending",
  itemListElement: clusterPostsAscending.map((post, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: post.data.title,
    url: new URL(`/blog/${post.slug}/`, Astro.site ?? Astro.url).toString()
  }))
};

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Blog",
      item: new URL("/blog/", Astro.site ?? Astro.url).toString()
    },
    {
      "@type": "ListItem",
      position: 2,
      name: entry.data.title,
      item: canonical
    }
  ]
};

const faqItems = entry.data.faqItems ?? [];
const faqJsonLd =
  faqItems.length > 0
    ? {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        mainEntity: faqItems.map((item) => ({
          "@type": "Question",
          name: item.q,
          acceptedAnswer: {
            "@type": "Answer",
            text: item.a
          }
        }))
      }
    : undefined;

const baseJsonLd = [blogPostingJsonLd, learningResourceJsonLd, breadcrumbJsonLd, learningPathJsonLd];
const jsonLd = faqJsonLd ? [...baseJsonLd, faqJsonLd] : baseJsonLd;
---
<BlogLayout
  title={pageTitle}
  description={pageDescription}
  canonical={canonical}
  ogImage={ogImagePath}
  ogType="article"
  jsonLd={jsonLd}
  gaContext={{ post_slug: entry.slug, cluster: entry.data.cluster }}
>
  <ReadingProgress />
  <Breadcrumbs title={entry.data.title} />
  <div class="post-shell">
    <div class="post-toc">
      <TableOfContents headings={tocHeadings} />
    </div>
    <div class="post-main">
      <div class="post-head">
        <h1>{entry.data.title}</h1>
        <p>{entry.data.description}</p>
        <p>{minutesRead} min read</p>
        <ExamTip title="Quick Revision Tip">
          <p>Summarize each section in one sentence before moving to the next chapter.</p>
        </ExamTip>
      </div>
      <div id="reading-trigger" aria-hidden="true"></div>
      <div class="post-body">
        <Content />
      </div>
      <PrevNextNav
        previous={previousPost ? { href: `/blog/${previousPost.slug}/`, title: previousPost.data.title } : undefined}
        next={nextPost ? { href: `/blog/${nextPost.slug}/`, title: nextPost.data.title } : undefined}
      />
      <ShareButtons
        url={canonical}
        title={entry.data.title}
        postSlug={entry.slug}
        cluster={entry.data.cluster}
        instagramId="champions.prep"
      />
      <MicroFeedback postSlug={entry.slug} cluster={entry.data.cluster} />
      <RelatedPosts currentSlug={entry.slug} cluster={entry.data.cluster} tags={entry.data.tags} />
      <SmartCTA postSlug={entry.slug} cluster={entry.data.cluster} />
      <AuthorCard name={entry.data.author} />
    </div>
  </div>
</BlogLayout>

<script>
  const headings = Array.from(document.querySelectorAll(".post-body h2[id], .post-body h3[id]"));
  for (const heading of headings) {
    if (heading.querySelector(".heading-anchor")) continue;
    const id = heading.getAttribute("id");
    if (!id) continue;
    const anchor = document.createElement("a");
    anchor.className = "heading-anchor";
    anchor.href = `#${id}`;
    anchor.setAttribute("aria-label", `Link to ${heading.textContent ?? "section"}`);
    anchor.textContent = "#";
    heading.append(anchor);
  }

  const readingTrigger = document.getElementById("reading-trigger");
  if (readingTrigger) {
    const observer = new IntersectionObserver(
      (entries) => {
        const [entry] = entries;
        if (!entry) return;
        document.body.classList.toggle("reading-mode", !entry.isIntersecting);
      },
      {
        threshold: 0
      }
    );
    observer.observe(readingTrigger);
  }

  const postBody = document.querySelector(".post-body");
  if (postBody instanceof HTMLElement) {
    const sectionHeadings = Array.from(postBody.querySelectorAll("h2[id]"));
    const breakpoints = sectionHeadings.length
      ? sectionHeadings
      : Array.from(postBody.querySelectorAll("h3[id]"));
    const completionMarkers = [];

    for (let index = 0; index < breakpoints.length; index++) {
      const start = breakpoints[index];
      const stop = breakpoints[index + 1] ?? null;
      const section = document.createElement("section");
      section.className = "reading-section";
      section.setAttribute("data-learning-section", "");
      section.setAttribute("data-complete", "false");

      const cue = document.createElement("span");
      cue.className = "section-completion-cue";
      cue.setAttribute("aria-hidden", "true");
      cue.textContent = "✓";
      start.append(cue);

      start.before(section);
      let cursor = start;
      while (cursor && cursor !== stop) {
        const next = cursor.nextSibling;
        section.append(cursor);
        cursor = next;
      }

      const marker = document.createElement("span");
      marker.className = "section-complete-marker";
      marker.setAttribute("aria-hidden", "true");
      section.append(marker);
      completionMarkers.push(marker);
    }

    if (completionMarkers.length) {
      const completionObserver = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            const marker = entry.target;
            const section = marker.closest(".reading-section");
            if (!(section instanceof HTMLElement)) continue;
            if (entry.isIntersecting) {
              section.setAttribute("data-complete", "true");
            } else if (entry.boundingClientRect.top > window.innerHeight) {
              section.setAttribute("data-complete", "false");
            }
          }
        },
        {
          threshold: 0,
          rootMargin: "0px 0px -72% 0px"
        }
      );

      for (const marker of completionMarkers) {
        completionObserver.observe(marker);
      }
    }
  }
</script>

<style>
  .post-shell {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  .post-toc {
    order: 1;
  }

  .post-main {
    order: 2;
  }

  .post-body {
    border: 1px solid transparent;
    border-radius: var(--shape-radius);
    padding: 0.2rem;
    scroll-snap-type: y mandatory;
    scroll-padding-top: 1rem;
  }

  .post-body :global(section.reading-section) {
    scroll-snap-align: start;
    scroll-snap-stop: always;
    position: relative;
    padding-bottom: 0.35rem;
  }

  .post-body :global(.section-complete-marker) {
    display: block;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
  }

  .post-body :global(.section-completion-cue) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1rem;
    height: 1rem;
    margin-left: 0.35rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    color: var(--color-lavender-600);
    font-size: 0.7rem;
    opacity: 0;
    transform: scale(0.8);
    transition: opacity 200ms ease-out, transform 200ms ease-out, border-color 200ms ease-out;
  }

  .post-body :global(section.reading-section[data-complete="true"] .section-completion-cue) {
    opacity: 0.92;
    transform: scale(1);
    border-color: color-mix(in srgb, var(--color-lavender-500), var(--color-border) 42%);
  }

  .post-head,
  .post-main :global(.breadcrumbs),
  .post-toc,
  .post-body,
  :global(.theme-toggle) {
    transition: opacity 200ms ease-out, transform 200ms ease-out, box-shadow 200ms ease-out,
      border-color 200ms ease-out;
  }

  #reading-trigger {
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
  }

  :global(body.reading-mode) .post-head {
    transform: scale(0.985);
    transform-origin: top center;
  }

  :global(body.reading-mode) .post-main :global(.breadcrumbs),
  :global(body.reading-mode) :global(.theme-toggle) {
    opacity: 0.7;
  }

  :global(body.reading-mode) .post-toc {
    opacity: 0.55;
    transform: scale(0.98);
  }

  :global(body.reading-mode) .post-toc:hover {
    opacity: 1;
    transform: scale(1);
  }

  :global(body.reading-mode) .post-body {
    border-color: color-mix(in srgb, var(--color-lavender-500), var(--color-border) 65%);
    box-shadow: 0 6px 22px color-mix(in srgb, var(--color-lavender-500), transparent 92%);
  }

  @media (min-width: 1024px) {
    .post-shell {
      grid-template-columns: minmax(0, 1fr) 260px;
      gap: 2rem;
      align-items: start;
    }

    .post-main {
      order: 1;
    }

    .post-toc {
      order: 2;
    }
  }
</style>
