---
import BlogLayout from "../../layouts/BlogLayout.astro";
import ExamTip from "../../components/ExamTip.astro";
import RelatedPosts from "../../components/RelatedPosts.astro";
import AuthorCard from "../../components/AuthorCard.astro";
import TableOfContents from "../../components/TableOfContents.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import PrevNextNav from "../../components/PrevNextNav.astro";
import ReadingProgress from "../../components/ReadingProgress.astro";
import ShareButtons from "../../components/ShareButtons.astro";
import MicroFeedback from "../../components/MicroFeedback.astro";
import SmartCTA from "../../components/SmartCTA.astro";
import { getClient } from "../../lib/sanity";
import {
  ALL_POSTS_QUERY,
  ALL_SLUGS_QUERY,
  POST_BY_SLUG_QUERY,
} from "../../lib/queries";
import type { Post } from "../../../studio/sanity.types";
import { markdownToHtml, calculateMinutesRead } from "../../lib/markdown";
import { slugifyTag } from "../../utils/content";
import { clusterLabel } from "../../utils/clusters";

export const prerender = false;

export async function getStaticPaths() {
  try {
    const client = getClient();
    const slugs = await client.fetch(ALL_SLUGS_QUERY);
    return slugs.map((item: { slug: string }) => ({
      params: { slug: item.slug },
    }));
  } catch {
    return [];
  }
}

const { slug } = Astro.params as { slug: string };
const isPreview = Astro.cookies.has("sanity-preview");
try {
  const client = getClient(isPreview);
  const post = await client.fetch<Post>(POST_BY_SLUG_QUERY, { slug });

  if (!post) {
    return Astro.redirect("/blog/");
  }
} catch (e) {
  return Astro.redirect("/blog/");
}

const { html: bodyHtml, headings } = await markdownToHtml(post.body ?? "");
const tocHeadings = headings.filter(
  (item) => item.depth === 2 || item.depth === 3,
);

const postDate = new Date(post.date ?? "");
const updatedDate = post.updatedDate ? new Date(post.updatedDate) : postDate;
const minutesRead = post.minutesRead ?? calculateMinutesRead(post.body ?? "");

const canonical = new URL(`/blog/${slug}/`, Astro.site ?? Astro.url).toString();
const ogImagePath = post.ogImage ?? `/blog/og/${slug}.png`;
const ogImageUrl = new URL(ogImagePath, Astro.site ?? Astro.url).toString();

const publishedLabel = postDate.toLocaleDateString("en-IN", {
  year: "numeric",
  month: "short",
  day: "numeric",
});
const updatedLabel = updatedDate.toLocaleDateString("en-IN", {
  year: "numeric",
  month: "short",
  day: "numeric",
});

// Related / prev-next navigation from full post list
const now = new Date();
const allPosts = (await client.fetch<Post[]>(ALL_POSTS_QUERY))
  .filter((p: any) => !p.publishDate || new Date(p.publishDate) <= now)
  .map((p: any) => ({ ...p, date: new Date(p.date ?? "") }))
  .sort((a: any, b: any) => b.date.getTime() - a.date.getTime());

const clusterPosts = allPosts.filter(
  (p: any) => p.cluster === (post.cluster ?? ""),
);
const currentIndex = clusterPosts.findIndex((p: any) => p.slug === slug);
const previousPost =
  currentIndex > 0 ? clusterPosts[currentIndex - 1] : undefined;
const nextPost =
  currentIndex >= 0 && currentIndex < clusterPosts.length - 1
    ? clusterPosts[currentIndex + 1]
    : undefined;
const clusterPostsAscending = [...clusterPosts].sort((a: any, b: any) => {
  const byDate = a.date.getTime() - b.date.getTime();
  return byDate !== 0 ? byDate : a.slug.localeCompare(b.slug);
});

// JSON-LD
const blogPostingJsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.title,
  description: post.description,
  datePublished: postDate.toISOString(),
  dateModified: updatedDate.toISOString(),
  image: ogImageUrl,
  author: { "@type": "Person", name: post.author },
  mainEntityOfPage: canonical,
  url: canonical,
};
const learningResourceJsonLd = {
  "@context": "https://schema.org",
  "@type": "LearningResource",
  learningResourceType: "Lesson",
  educationalLevel: "Class 11-12",
  teaches: post.cluster,
  name: post.title,
  description: post.description,
  url: canonical,
};
const learningPathJsonLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: `${post.cluster} Learning Path`,
  itemListOrder: "https://schema.org/ItemListOrderAscending",
  itemListElement: clusterPostsAscending.map((p: any, index: number) => ({
    "@type": "ListItem",
    position: index + 1,
    name: p.title,
    url: new URL(`/blog/${p.slug}/`, Astro.site ?? Astro.url).toString(),
  })),
};
const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Blog",
      item: new URL("/blog/", Astro.site ?? Astro.url).toString(),
    },
    { "@type": "ListItem", position: 2, name: post.title, item: canonical },
  ],
};
const faqItems = post.faqItems ?? [];
const faqJsonLd =
  faqItems.length > 0
    ? {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        mainEntity: faqItems.map((item: any) => ({
          "@type": "Question",
          name: item.q,
          acceptedAnswer: { "@type": "Answer", text: item.a },
        })),
      }
    : undefined;

const baseJsonLd = [
  blogPostingJsonLd,
  learningResourceJsonLd,
  breadcrumbJsonLd,
  learningPathJsonLd,
];
const jsonLd = faqJsonLd ? [...baseJsonLd, faqJsonLd] : baseJsonLd;
---

<BlogLayout
  title={post.title ?? "ChampionsPrep"}
  description={post.description ?? ""}
  canonical={canonical}
  ogImage={ogImagePath}
  ogType="article"
  jsonLd={jsonLd}
  gaContext={{ post_slug: slug, cluster: post.cluster ?? "" }}
  author={post.author ?? "ChampionsPrep"}
  publishedDate={postDate.toISOString()}
  updatedDate={updatedDate.toISOString()}
  articleTags={(post.tags as string[]) ?? []}
  articleSection={post.cluster ?? ""}
>
  <ReadingProgress />
  <Breadcrumbs title={post.title} />
  <section class="post-shell">
    <div class="post-main">
      <header class="post-head" data-cluster={post.cluster}>
        <div class="post-head__cluster-rule" aria-hidden="true"></div>
        <p class="post-head__eyebrow">{clusterLabel(post.cluster)}</p>
        <h1 class="post-head__title">{post.title}</h1>
        <p class="post-head__dek">{post.description}</p>
        <p class="post-head__byline" aria-label="Article metadata">
          <span class="post-head__author">{post.author}</span>
          <span class="post-head__sep" aria-hidden="true">·</span>
          <time datetime={postDate.toISOString()}>{publishedLabel}</time>
          <span class="post-head__sep" aria-hidden="true">·</span>
          <span>{minutesRead} min read</span>
        </p>
        {
          (post.tags ?? []).length > 0 && (
            <div class="post-head__tags" aria-label="Post tags">
              {(post.tags ?? []).map((tag: string) => (
                <a href={`/blog/tag/${slugifyTag(tag)}/`}>{tag}</a>
              ))}
            </div>
          )
        }
      </header>

      <ExamTip title="Quick Revision Tip">
        <p>
          Summarize each section in one sentence before moving to the next
          chapter.
        </p>
      </ExamTip>

      <div class="post-body" set:html={bodyHtml} />

      <PrevNextNav
        previous={previousPost
          ? { href: `/blog/${previousPost.slug}/`, title: previousPost.title }
          : undefined}
        next={nextPost
          ? { href: `/blog/${nextPost.slug}/`, title: nextPost.title }
          : undefined}
      />
      <ShareButtons
        url={canonical}
        title={post.title}
        postSlug={slug}
        cluster={post.cluster}
        instagramId="champions.prep"
      />
      <MicroFeedback postSlug={slug} cluster={post.cluster} />
      <RelatedPosts
        currentSlug={slug}
        cluster={post.cluster}
        tags={post.tags}
      />
      <SmartCTA postSlug={slug} cluster={post.cluster} />
      <AuthorCard name={post.author} />
    </div>

    <aside class="post-toc">
      <div class="post-toc__panel">
        <TableOfContents headings={tocHeadings} />
      </div>
    </aside>
  </section>
</BlogLayout>

<script>
  const headings = Array.from(
    document.querySelectorAll(".post-body h2[id], .post-body h3[id]"),
  );
  for (const heading of headings) {
    if (heading.querySelector(".heading-anchor")) continue;
    const id = heading.getAttribute("id");
    if (!id) continue;
    const anchor = document.createElement("a");
    anchor.className = "heading-anchor";
    anchor.href = `#${id}`;
    anchor.setAttribute(
      "aria-label",
      `Link to ${heading.textContent ?? "section"}`,
    );
    anchor.textContent = "#";
    heading.append(anchor);
  }
</script>

<style>
  :global(.editorial) {
    max-width: min(100%, 1120px);
  }

  .post-shell {
    margin-top: var(--space-lg);
    display: grid;
    gap: var(--space-lg);
    grid-template-columns: minmax(0, 1fr);
  }

  .post-main {
    display: grid;
    gap: var(--space-md);
  }

  /* Post header – magazine opener */
  .post-head {
    padding: clamp(1.4rem, 3.5vw, 2.4rem) 0 clamp(1.2rem, 2.5vw, 1.8rem);
    overflow: hidden;
  }

  /* Cluster-coloured rule at top */
  .post-head__cluster-rule {
    height: 4px;
    border-radius: 2px;
    background: var(--color-purple-deep);
    margin-bottom: 1.4rem;
    width: 3rem;
  }

  .post-head[data-cluster="taxation"] .post-head__cluster-rule {
    background: #e07c3e;
  }
  .post-head[data-cluster="accountancy"] .post-head__cluster-rule {
    background: #4a90d9;
  }
  .post-head[data-cluster="business-studies"] .post-head__cluster-rule {
    background: #5da55d;
  }
  .post-head[data-cluster="economics"] .post-head__cluster-rule {
    background: #d4af37;
  }
  .post-head[data-cluster="corporate-law"] .post-head__cluster-rule {
    background: #c0392b;
  }
  .post-head[data-cluster="tips-tricks"] .post-head__cluster-rule {
    background: #16a085;
  }
  .post-head[data-cluster="shortcuts"] .post-head__cluster-rule {
    background: #f39c12;
  }
  .post-head[data-cluster="mindmaps"] .post-head__cluster-rule {
    background: #8e44ad;
  }
  .post-head[data-cluster="quick-quiz"] .post-head__cluster-rule {
    background: #2980b9;
  }

  .post-head__eyebrow {
    margin: 0 0 0.7rem;
    color: var(--color-purple-deep);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 0.72rem;
    font-weight: 700;
  }

  .post-head__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 3.1rem);
    line-height: 1.08;
    letter-spacing: -0.03em;
    color: var(--color-text-heading);
    max-width: 22ch;
  }

  .post-head__dek {
    margin: 1rem 0 0;
    color: var(--color-text-secondary);
    max-width: 58ch;
    font-size: clamp(1rem, 1.3vw, 1.12rem);
    line-height: 1.68;
    font-weight: 400;
  }

  .post-head__byline {
    margin: 1.1rem 0 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.86rem;
    color: var(--color-text-secondary);
  }

  .post-head__author {
    font-weight: 700;
    color: var(--color-text-primary);
  }

  .post-head__sep {
    opacity: 0.45;
    font-size: 0.7em;
  }

  .post-head__tags {
    margin-top: 1rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .post-head__tags a {
    border: 1px solid color-mix(in srgb, var(--color-border), transparent 20%);
    border-radius: 999px;
    background: transparent;
    padding: 0.22rem 0.65rem;
    font-size: 0.78rem;
    text-decoration: none;
    color: var(--color-text-secondary);
    transition:
      border-color var(--transition-base),
      color var(--transition-base);
  }

  .post-head__tags a:hover {
    border-color: var(--color-purple-deep);
    color: var(--color-purple-deep);
  }

  .post-body {
    border-radius: var(--shape-radius);
    border: 1px solid color-mix(in srgb, var(--color-border), transparent 42%);
    background: color-mix(in srgb, var(--color-bg), transparent 8%);
    padding: clamp(1rem, 2.5vw, 1.8rem);
  }

  .post-toc__panel {
    border: 1px solid var(--color-border);
    border-radius: var(--shape-radius);
    background: var(--color-bg-muted);
    padding: 0.75rem;
  }

  .post-toc {
    order: -1;
  }

  .post-main {
    order: 1;
  }

  @media (min-width: 1040px) {
    .post-shell {
      grid-template-columns: minmax(0, 1fr) 280px;
      align-items: start;
      gap: var(--space-xl);
    }

    .post-toc {
      order: 0;
      position: sticky;
      top: 5.4rem;
    }

    .post-main {
      order: 0;
    }
  }

  @media (max-width: 640px) {
    .post-head {
      padding: 1rem;
    }

    .post-head__meta {
      gap: 0.36rem;
    }

    .post-head__meta span {
      font-size: 0.76rem;
      padding: 0.23rem 0.55rem;
    }

    .post-head__tags {
      gap: 0.32rem;
    }

    .post-head__tags a {
      padding: 0.35rem 0.75rem;
      font-size: 0.82rem;
      line-height: 1.2;
    }
  }
</style>
