---
import { getCollection, type CollectionEntry } from "astro:content";
import BlogLayout from '../../layouts/BlogLayout.astro';
import ExamTip from "../../components/ExamTip.astro";
import RelatedPosts from "../../components/RelatedPosts.astro";
import AuthorCard from "../../components/AuthorCard.astro";
import TableOfContents from "../../components/TableOfContents.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import PrevNextNav from "../../components/PrevNextNav.astro";
import ReadingProgress from "../../components/ReadingProgress.astro";
import ShareButtons from "../../components/ShareButtons.astro";
import MicroFeedback from "../../components/MicroFeedback.astro";
import SmartCTA from "../../components/SmartCTA.astro";
import { calculateMinutesRead, slugifyTag } from "../../utils/content";
import { clusterLabel } from "../../utils/clusters";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  return posts.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry }
  }));
}

const { entry } = Astro.props as { entry: CollectionEntry<"blog"> };
const { Content, headings } = await entry.render();
const tocHeadings = headings.filter((item) => item.depth === 2 || item.depth === 3);
const canonical = new URL(`/blog/${entry.slug}/`, Astro.site ?? Astro.url).toString();
const ogImagePath = entry.data.ogImage ?? `/blog/og/${entry.slug}.png`;
const ogImageUrl = new URL(ogImagePath, Astro.site ?? Astro.url).toString();
const minutesRead = entry.data.minutesRead ?? calculateMinutesRead(entry.body);
const pageTitle = entry.data.title;
const pageDescription = entry.data.description;
const publishedLabel = entry.data.date.toLocaleDateString("en-IN", {
  year: "numeric",
  month: "short",
  day: "numeric"
});
const updatedLabel = (entry.data.updatedDate ?? entry.data.date).toLocaleDateString("en-IN", {
  year: "numeric",
  month: "short",
  day: "numeric"
});
const allPosts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
const clusterPosts = allPosts.filter((post) => post.data.cluster === entry.data.cluster);
const clusterPostsAscending = [...clusterPosts].sort((a, b) => {
  const byDate = a.data.date.getTime() - b.data.date.getTime();
  return byDate !== 0 ? byDate : a.slug.localeCompare(b.slug);
});
const currentIndex = clusterPosts.findIndex((post) => post.slug === entry.slug);
const previousPost = currentIndex > 0 ? clusterPosts[currentIndex - 1] : undefined;
const nextPost =
  currentIndex >= 0 && currentIndex < clusterPosts.length - 1
    ? clusterPosts[currentIndex + 1]
    : undefined;
const blogPostingJsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: entry.data.title,
  description: entry.data.description,
  datePublished: entry.data.date.toISOString(),
  dateModified: (entry.data.updatedDate ?? entry.data.date).toISOString(),
  image: ogImageUrl,
  author: {
    "@type": "Person",
    name: entry.data.author
  },
  mainEntityOfPage: canonical,
  url: canonical
};
const learningResourceJsonLd = {
  "@context": "https://schema.org",
  "@type": "LearningResource",
  learningResourceType: "Lesson",
  educationalLevel: "Class 11-12",
  teaches: entry.data.cluster,
  name: entry.data.title,
  description: entry.data.description,
  url: canonical
};
const learningPathJsonLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: `${entry.data.cluster} Learning Path`,
  itemListOrder: "https://schema.org/ItemListOrderAscending",
  itemListElement: clusterPostsAscending.map((post, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: post.data.title,
    url: new URL(`/blog/${post.slug}/`, Astro.site ?? Astro.url).toString()
  }))
};

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Blog",
      item: new URL("/blog/", Astro.site ?? Astro.url).toString()
    },
    {
      "@type": "ListItem",
      position: 2,
      name: entry.data.title,
      item: canonical
    }
  ]
};

const faqItems = entry.data.faqItems ?? [];
const faqJsonLd =
  faqItems.length > 0
    ? {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        mainEntity: faqItems.map((item) => ({
          "@type": "Question",
          name: item.q,
          acceptedAnswer: {
            "@type": "Answer",
            text: item.a
          }
        }))
      }
    : undefined;

const baseJsonLd = [blogPostingJsonLd, learningResourceJsonLd, breadcrumbJsonLd, learningPathJsonLd];
const jsonLd = faqJsonLd ? [...baseJsonLd, faqJsonLd] : baseJsonLd;
---
<BlogLayout
  title={pageTitle}
  description={pageDescription}
  canonical={canonical}
  ogImage={ogImagePath}
  ogType="article"
  jsonLd={jsonLd}
  gaContext={{ post_slug: entry.slug, cluster: entry.data.cluster }}
>
  <ReadingProgress />
  <Breadcrumbs title={entry.data.title} />
  <section class="post-shell">
    <div class="post-main">
      <header class="post-head">
        <p class="post-head__eyebrow">{clusterLabel(entry.data.cluster)}</p>
        <h1>{entry.data.title}</h1>
        <p class="post-head__dek">{entry.data.description}</p>
        <div class="post-head__meta" aria-label="Article metadata">
          <span>Published {publishedLabel}</span>
          <span>Updated {updatedLabel}</span>
          <span>{minutesRead} min read</span>
          <span>By {entry.data.author}</span>
        </div>
        {entry.data.tags.length > 0 && (
          <div class="post-head__tags" aria-label="Post tags">
            {entry.data.tags.map((tag) => (
              <a href={`/blog/tag/${slugifyTag(tag)}/`}>{tag}</a>
            ))}
          </div>
        )}
      </header>

      <ExamTip title="Quick Revision Tip">
        <p>Summarize each section in one sentence before moving to the next chapter.</p>
      </ExamTip>

      <div class="post-body">
        <Content />
      </div>

      <PrevNextNav
        previous={previousPost ? { href: `/blog/${previousPost.slug}/`, title: previousPost.data.title } : undefined}
        next={nextPost ? { href: `/blog/${nextPost.slug}/`, title: nextPost.data.title } : undefined}
      />
      <ShareButtons
        url={canonical}
        title={entry.data.title}
        postSlug={entry.slug}
        cluster={entry.data.cluster}
        instagramId="champions.prep"
      />
      <MicroFeedback postSlug={entry.slug} cluster={entry.data.cluster} />
      <RelatedPosts currentSlug={entry.slug} cluster={entry.data.cluster} tags={entry.data.tags} />
      <SmartCTA postSlug={entry.slug} cluster={entry.data.cluster} />
      <AuthorCard name={entry.data.author} />
    </div>

    <aside class="post-toc">
      <div class="post-toc__panel">
        <TableOfContents headings={tocHeadings} />
      </div>
    </aside>
  </section>
</BlogLayout>

<script>
  const headings = Array.from(document.querySelectorAll(".post-body h2[id], .post-body h3[id]"));
  for (const heading of headings) {
    if (heading.querySelector(".heading-anchor")) continue;
    const id = heading.getAttribute("id");
    if (!id) continue;
    const anchor = document.createElement("a");
    anchor.className = "heading-anchor";
    anchor.href = `#${id}`;
    anchor.setAttribute("aria-label", `Link to ${heading.textContent ?? "section"}`);
    anchor.textContent = "#";
    heading.append(anchor);
  }
</script>

<style>
  :global(.editorial) {
    max-width: min(100%, 1120px);
  }

  .post-shell {
    margin-top: 0.75rem;
    display: grid;
    gap: 1.25rem;
    grid-template-columns: minmax(0, 1fr);
  }

  .post-main {
    display: grid;
    gap: 1rem;
  }

  .post-head {
    padding: clamp(1rem, 2vw, 1.5rem);
    border-radius: calc(var(--shape-radius) + 2px);
    border: 1px solid var(--color-border);
    background: linear-gradient(
      155deg,
      color-mix(in srgb, var(--color-lavender-light), white 24%),
      color-mix(in srgb, var(--color-bg), var(--color-cream) 24%)
    );
  }

  .post-head h1 {
    margin: 0.25rem 0 0;
    line-height: 1.15;
  }

  .post-head__eyebrow {
    margin: 0;
    color: var(--color-purple-deep);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.74rem;
    font-weight: 700;
  }

  .post-head__dek {
    margin: 0.7rem 0 0;
    color: var(--color-text-secondary);
    max-width: 70ch;
  }

  .post-head__meta {
    margin-top: 0.9rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .post-head__meta span {
    border: 1px solid color-mix(in srgb, var(--color-border), transparent 12%);
    background: color-mix(in srgb, var(--color-bg), transparent 10%);
    border-radius: 999px;
    padding: 0.26rem 0.62rem;
    font-size: 0.82rem;
    color: var(--color-text-secondary);
  }

  .post-head__tags {
    margin-top: 0.8rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .post-head__tags a {
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: var(--color-bg);
    padding: 0.2rem 0.55rem;
    font-size: 0.78rem;
    text-decoration: none;
  }

  .post-body {
    border-radius: calc(var(--shape-radius) + 2px);
    border: 1px solid var(--color-border);
    background: var(--color-bg);
    padding: clamp(1rem, 2.4vw, 1.7rem);
    box-shadow: 0 12px 26px color-mix(in srgb, var(--color-purple-deep), transparent 92%);
  }

  .post-toc__panel {
    border: 1px solid var(--color-border);
    border-radius: var(--shape-radius);
    background: var(--color-bg-muted);
    padding: 0.75rem;
  }

  @media (min-width: 1040px) {
    .post-shell {
      grid-template-columns: minmax(0, 1fr) 280px;
      align-items: start;
      gap: 1.6rem;
    }

    .post-toc {
      position: sticky;
      top: 5.4rem;
    }
  }
</style>
