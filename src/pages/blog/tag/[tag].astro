---
import BlogLayout from '../../../layouts/BlogLayout.astro';
import PostCard from "../../../components/PostCard.astro";
import { sanityClient } from "../../../lib/sanity";
import { ALL_POSTS_QUERY } from "../../../lib/queries";
import { calculateMinutesRead } from "../../../lib/markdown";
import { slugifyTag } from "../../../utils/content";

export async function getStaticPaths() {
  const now = new Date();
  const rawPosts = await sanityClient.fetch(ALL_POSTS_QUERY);
  const posts = rawPosts.filter((p: any) => !p.publishDate || new Date(p.publishDate) <= now);

  const tagMap = new Map<string, string>();
  for (const post of posts) {
    for (const tag of (post.tags as string[])) {
      const slug = slugifyTag(tag);
      if (!tagMap.has(slug)) tagMap.set(slug, tag);
    }
  }

  return Array.from(tagMap.entries()).map(([slug, label]) => ({
    params: { tag: slug },
    props: { tagSlug: slug, tagLabel: label }
  }));
}

const { tagSlug, tagLabel } = Astro.props as { tagSlug: string; tagLabel: string };
const now = new Date();
const rawPosts = await sanityClient.fetch(ALL_POSTS_QUERY);

const posts = rawPosts
  .filter((p: any) => !p.publishDate || new Date(p.publishDate) <= now)
  .filter((p: any) => (p.tags as string[]).some((tag) => slugifyTag(tag) === tagSlug))
  .sort((a: any, b: any) => new Date(b.date).getTime() - new Date(a.date).getTime())
  .map((p: any) => ({
    ...p,
    date: new Date(p.date),
    minutesRead: p.minutesRead ?? calculateMinutesRead(p.body ?? ''),
  }));

const pageTitle = `Tag: ${tagLabel}`;
const pageDescription = `Posts tagged with ${tagLabel}.`;
const canonical = new URL(`/blog/tag/${tagSlug}/`, Astro.site ?? Astro.url).toString();
---
<BlogLayout title={pageTitle} description={pageDescription} canonical={canonical}>
  <header class="tag-page__head">
    <h1>{pageTitle}</h1>
    <p>{pageDescription}</p>
    <p class="tag-page__back">
      <a href="/blog/">Back to all posts</a>
    </p>
  </header>

  {posts.length === 0 ? (
    <p class="tag-page__empty">No posts found for this tag.</p>
  ) : (
    <section class="tag-page__grid">
      {posts.map((post: any) => (
        <PostCard
          href={`/blog/${post.slug}/`}
          title={post.title}
          description={post.description}
          date={post.date}
          minutesRead={post.minutesRead}
          cluster={post.cluster}
          tags={post.tags}
        />
      ))}
    </section>
  )}
</BlogLayout>

<style>
  .tag-page__head p {
    margin-top: 0.4rem;
    color: var(--color-text-secondary);
  }

  .tag-page__back {
    margin-top: 0.6rem;
    font-size: 0.92rem;
  }

  .tag-page__grid {
    margin-top: 1rem;
    display: grid;
    gap: 0.85rem;
  }

  .tag-page__empty {
    margin-top: var(--space-xl);
    text-align: center;
    color: var(--color-text-secondary);
  }

  .tag-page__empty::before {
    content: "◇";
    display: block;
    font-size: 2.2rem;
    margin-bottom: var(--space-sm);
    color: var(--color-purple-deep);
    opacity: 0.35;
  }

  @media (min-width: 900px) {
    .tag-page__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      align-items: start;
    }
  }
</style>
