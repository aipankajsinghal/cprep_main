---
import { getClient } from '../lib/sanity';
import { PAGE_BY_SLUG_QUERY } from '../lib/queries';
import BaseLayout from '../layouts/web/BaseLayout.astro';
import Breadcrumb from '../components/web/Breadcrumb.astro';
import SchemaMarkup from '../components/web/SchemaMarkup.astro';
import type { Page } from '../types';

export const prerender = true;

export async function getStaticPaths() {
  const { getClient } = await import('../lib/sanity');
  const client = getClient();
  const pages = await client.fetch(`*[_type == "page"] { "slug": slug.current }`);
  return pages.map((p: any) => ({ params: { slug: p.slug } }));
}

const client = getClient();
const { slug } = Astro.params;
const page = await client.fetch(PAGE_BY_SLUG_QUERY, { slug }) as Page;

if (!page) throw new Error(`Page with slug "${slug}" not found`);

const pageTitle = page.title;
const seoTitle = page.metaTitle || pageTitle;
const pageDescription = page.description || '';
const pageNoIndex = page.noIndex ?? false;

---

<BaseLayout
  title={seoTitle}
  description={pageDescription}
  noIndex={pageNoIndex}
>
  <SchemaMarkup type="WebPage" data={{ name: pageTitle, description: pageDescription }} />
  <div class="container" style="margin-top: 2rem;">
    <Breadcrumb items={[{ name: 'Home', url: '/' }, { name: pageTitle }]} />
  </div>

  <section class="content-section">
    <div class="container">
      <h1>{pageTitle}</h1>
      <p class="subtitle">{pageDescription}</p>
      
      {page.body && <div class="prose" set:html={page.body} />}

      {slug === 'contact' && (
        <div class="contact-form-panel card mt-6">
          <form id="contact-form" class="grid gap-4" novalidate>
            <div class="form-group">
              <label for="name" class="label">Full Name</label>
              <input type="text" id="name" name="name" class="input" placeholder="Your Name" required aria-required="true" />
              <span class="form-error hidden" id="name-error"></span>
            </div>
            <div class="form-group">
              <label for="email" class="label">Email Address</label>
              <input type="email" id="email" name="email" class="input" placeholder="you@example.com" required aria-required="true" />
              <span class="form-error hidden" id="email-error"></span>
            </div>
            <div class="form-group">
              <label for="message" class="label">Your Message</label>
              <textarea id="message" name="message" class="textarea" rows="5" placeholder="How can we help you?" required aria-required="true"></textarea>
              <span class="form-error hidden" id="message-error"></span>
            </div>
            <!-- Honeypot field -->
            <input type="text" name="website_url" id="website_url" style="display: none;" tabindex="-1" autocomplete="off" />
            <input type="hidden" name="csrfToken" id="csrfToken" />
            <button type="submit" class="btn-primary" id="submit-btn">Send Message</button>
          </form>
          <div id="form-success" class="mt-4 hidden form-success" role="alert" aria-live="polite">
            <strong>Success!</strong> Thank you for your message. We'll get back to you within 24 hours.
          </div>
          <div id="form-error" class="mt-4 hidden form-error" role="alert" aria-live="assertive">
            <strong>Error:</strong> <span id="error-message"></span> Please try again.
          </div>
          <div id="form-loading" class="mt-4 hidden form-loading" role="status" aria-live="polite">
            <strong>Sending...</strong> Please wait.
          </div>
        </div>
      )}
    </div>
  </section>
</BaseLayout>

<style is:global>
  .content-section { padding: 4rem 0; }
  .subtitle { color: var(--cp-slate-medium); margin-bottom: 2rem; font-size: 1.25rem; }
  .contact-form-panel { margin-top: 1.5rem; background: var(--cp-white); padding: 2rem; border-radius: 0.5rem; border: 1px solid var(--cp-lavender); }
  .hidden { display: none; }
  
  .form-error { color: #d32f2f; font-size: 0.875rem; margin-top: 0.25rem; display: block; }
  .form-success { background: #e8f5e9; border: 1px solid #4caf50; color: #2e7d32; padding: 1rem; border-radius: 0.5rem; }
  .form-error { background: #ffebee; border: 1px solid #d32f2f; color: #c62828; padding: 1rem; border-radius: 0.5rem; }
  .form-loading { background: #e3f2fd; border: 1px solid #1976d2; color: #1565c0; padding: 1rem; border-radius: 0.5rem; }
  
  .form-group { display: flex; flex-direction: column; margin-bottom: 1rem; }
  .label { font-weight: 600; margin-bottom: 0.5rem; color: var(--cp-slate-dark); }
  .input, .textarea { padding: 0.75rem; border: 1px solid var(--cp-lavender); border-radius: 0.5rem; font-family: inherit; font-size: 1rem; background: var(--cp-white); color: var(--cp-slate-dark); }
  .input:focus, .textarea:focus { outline: none; border-color: var(--cp-purple-deep); box-shadow: 0 0 0 3px rgba(107, 91, 149, 0.1); }
  .textarea { resize: vertical; min-height: 120px; }

  .prose {
    color: var(--cp-slate-dark);
    line-height: 1.6;
  }
  .prose h2 { margin-top: 2rem; margin-bottom: 1rem; }
  .prose p { margin-bottom: 1.25rem; }
</style>

<script>
  if (typeof document !== 'undefined') {
    const form = document.querySelector('#contact-form') as HTMLFormElement | null;
    const successMsg = document.querySelector('#form-success');
    const errorMsg = document.querySelector('#form-error');
    const loadingMsg = document.querySelector('#form-loading');
    const submitBtn = document.querySelector('#submit-btn') as HTMLButtonElement | null;
    const errorMessageSpan = document.querySelector('#error-message');

    async function ensureCsrfToken() {
      try {
        const res = await fetch('/api/csrf', { method: 'GET', credentials: 'same-origin' });
        if (res.ok) {
          const json = await res.json();
          const tokenEl = document.querySelector('#csrfToken') as HTMLInputElement | null;
          if (tokenEl) tokenEl.value = json.csrfToken || '';
        }
      } catch (e) {}
    }

    if (form) {
      ensureCsrfToken();
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (successMsg) successMsg.classList.add('hidden');
        if (errorMsg) errorMsg.classList.add('hidden');
        if (loadingMsg) loadingMsg.classList.remove('hidden');
        if (submitBtn) { submitBtn.disabled = true; submitBtn.textContent = 'Sending...'; }

        const formData = new FormData(form as HTMLFormElement);
        const name = formData.get('name');
        const email = formData.get('email');
        const message = formData.get('message');
        const csrfToken = formData.get('csrfToken');

        try {
          const response = await fetch('/api/contact', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ name, email, message, csrfToken }),
            credentials: 'same-origin',
          });
          const result = await response.json();
          if (response.ok && result.success) {
            if (loadingMsg) loadingMsg.classList.add('hidden');
            if (successMsg) successMsg.classList.remove('hidden');
            if (form instanceof HTMLFormElement) form.reset();
          } else {
            throw new Error(result.error || 'Failed to send message');
          }
        } catch (error) {
          if (loadingMsg) loadingMsg.classList.add('hidden');
          if (errorMsg) {
            errorMsg.classList.remove('hidden');
            if (errorMessageSpan) errorMessageSpan.textContent = error instanceof Error ? error.message : 'An error occurred';
          }
        } finally {
          if (submitBtn) { submitBtn.disabled = false; submitBtn.textContent = 'Send Message'; }
        }
      });
    }
  }
</script>
