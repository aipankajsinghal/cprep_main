---
interface FAQItem {
  name: string;
  answer: string;
}

interface Props {
  data?: FAQItem[];
}

const { data = [] } = Astro.props as Props;
---

<section class="faq-section">
  <div class="container">
    <div class="section-header">
      <h2>Frequently Asked Questions</h2>
      <p>Everything you need to know about ChampionsPrep</p>
    </div>

    <div class="faq-container">
      {
        data.map((faq: FAQItem, index: number) => (
          <details class="faq-item" open={index === 0}>
            <summary class="faq-question">
              <span>{faq.name}</span>
              <svg
                class="faq-icon"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </summary>
            <div class="faq-answer">
              <p>{faq.answer}</p>
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq-section {
    padding: 60px 20px;
    background-color: var(--cp-lavender-light);
    color: var(--cp-slate-dark);
  }

  .container {
    max-width: 800px;
    margin: 0 auto;
  }

  .section-header {
    text-align: center;
    margin-bottom: 50px;
  }

  .section-header h2 {
    font-size: 2.5rem;
    color: var(--cp-slate-dark);
    margin-bottom: 10px;
    text-wrap: balance;
  }

  .section-header p {
    font-size: 1.1rem;
    color: var(--cp-slate-medium);
    text-wrap: pretty;
  }

  .faq-container {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .faq-item {
    background: var(--cp-white) !important;
    border-radius: 8px;
    overflow: hidden;
    box-shadow: var(--shadow-1);
    transition: all 0.3s ease;
  }

  .faq-item:hover {
    box-shadow: var(--shadow-2);
  }

  .faq-item[open] .faq-icon {
    transform: rotate(180deg);
  }

  .faq-question {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px;
    cursor: pointer;
    color: var(--cp-slate-dark);
    font-size: 1.1rem;
    font-weight: 600;
    user-select: none;
    transition: background-color 0.2s ease;
  }

  .faq-question:hover {
    background-color: var(--cp-lavender);
    color: var(--cp-slate-dark);
  }

  .faq-icon {
    width: 24px;
    height: 24px;
    color: var(--cp-purple-deep);
    flex-shrink: 0;
    transition: transform 0.3s ease;
  }

  .faq-answer {
    padding: 0 20px 20px 20px;
    color: var(--cp-slate-medium);
    line-height: 1.6;
    animation: slideDown 0.3s ease;
  }

  @keyframes slideDown {
    from {
      opacity: 0;
      transform: translateY(-10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 768px) {
    .faq-section {
      padding: 40px 16px;
    }

    .section-header {
      margin-bottom: 30px;
    }

    .section-header h2 {
      font-size: 1.8rem;
    }

    .faq-question {
      font-size: 1rem;
      padding: 15px;
    }

    .faq-answer {
      padding: 0 15px 15px 15px;
      font-size: 0.95rem;
    }
  }

  @media (max-width: 480px) {
    .section-header h2 {
      font-size: 1.5rem;
    }

    .faq-question {
      font-size: 0.95rem;
      padding: 12px;
      gap: 8px;
    }

    .faq-answer {
      padding: 0 12px 12px 12px;
      font-size: 0.9rem;
    }

    .faq-container {
      gap: 12px;
    }
  }
</style>
