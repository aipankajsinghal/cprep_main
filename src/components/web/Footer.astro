---
const year = new Date().getFullYear();
const APP_LOGIN = "https://app.championsprep.in/login";
const APP_REGISTER = "https://app.championsprep.in/register";

const quickLinks = [
  { label: "Home", href: "/" },
  { label: "Courses", href: "/subjects" },
  { label: "About", href: "/about" },
  { label: "Pricing", href: "/pricing" },
  { label: "Contact", href: "/contact" },
];

const legalLinks = [
  { label: "Privacy Policy", href: "/privacy-policy" },
  { label: "Terms of Service", href: "/terms-of-service" },
  { label: "Refund Policy", href: "/refund-policy" },
  { label: "Disclaimer", href: "/disclaimer" },
];
---

<footer class="footer" data-pagefind-ignore>
  <div class="container footer-grid">
    <div class="footer-brand">
      <a href="/" class="logo" aria-label="ChampionsPrep Homepage">
        <img
          src="/Logo.svg"
          alt="ChampionsPrep - AI-powered learning for Class 11-12 Commerce"
          width="150"
          height="40"
          decoding="async"
          loading="lazy"
        />
      </a>
      <p class="mt-3">
        AI-powered learning for Class 11-12 Commerce students in India. Master
        Accountancy, Economics, and Business Studies.
      </p>
      <div class="contact-info mt-4">
        <p>
          Email: <a href="mailto:support@championsprep.in"
            >support@championsprep.in</a
          >
        </p>
      </div>
      <div class="social-links mt-4">
        <a
          href="https://facebook.com/championsprep"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Facebook"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><path
              d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"
            ></path></svg
          >
        </a>
        <a
          href="https://twitter.com/championsprep"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Twitter"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><path
              d="M23 3a10.9 10.9 0 0 1-3.14 1.53 4.48 4.48 0 0 0-7.86 3v1A10.66 10.66 0 0 1 3 4s-4 9 5 13a11.64 11.64 0 0 1-7 2c9 5 20 0 20-11.5a4.5 4.5 0 0 0-.08-.83A7.72 7.72 0 0 0 23 3z"
            ></path></svg
          >
        </a>
        <a
          href="https://linkedin.com/company/championsprep"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="LinkedIn"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><path
              d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"
            ></path><rect x="2" y="9" width="4" height="12"></rect><circle
              cx="4"
              cy="4"
              r="2"></circle></svg
          >
        </a>
      </div>
    </div>

    <div class="footer-links">
      <h3>Quick Links</h3>
      <ul>
        {
          quickLinks.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="footer-links">
      <h3>Legal</h3>
      <ul>
        {
          legalLinks.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="footer-cta">
      <h3>Get Started</h3>
      <p>Ready to start your journey?</p>
      <a
        href={APP_REGISTER}
        class="btn btn-primary mt-2"
        rel="noopener noreferrer"
        target="_blank">Start Learning →</a
      >
      <p class="mt-2 text-small">
        Already a member? <a
          href={APP_LOGIN}
          rel="noopener noreferrer"
          target="_blank">Login</a
        >
      </p>
    </div>
  </div>

  <div class="footer-bottom mt-5">
    <div class="container flex flex-between">
      <p>&copy; {year} PRePS AI Private Limited. All rights reserved.</p>
      <p>Made with ❤️ in India</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background-color: var(--cp-slate-dark);
    color: var(--cp-white);
    padding-block-start: var(--size-9);
    padding-block-end: var(--size-4);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1.5fr;
    gap: var(--size-8);
  }

  .footer-brand p {
    color: var(--cp-lavender-light);
    opacity: 0.8;
  }

  .footer h3 {
    color: var(--cp-white);
    font-size: var(--font-size-3);
    margin-block-end: var(--size-4);
  }

  .footer-links ul {
    display: flex;
    flex-direction: column;
    gap: var(--size-2);
  }

  .footer-links a {
    color: var(--cp-white);
    transition: color 0.2s ease;
  }

  .footer-links a:hover {
    color: var(--cp-gold);
  }

  /* WCAG 2.1.1 Keyboard - Ensure links are keyboard accessible */
  .footer-links a:focus-visible {
    outline: 2px solid var(--cp-gold);
    outline-offset: 2px;
    border-radius: 4px;
  }

  .social-links {
    display: flex;
    gap: var(--size-4);
  }

  .social-links a {
    color: var(--cp-lavender-light);
    opacity: 0.7;
    transition: all 0.2s ease;
  }

  .social-links a:hover {
    opacity: 1;
    color: var(--cp-white);
    transform: translateY(-2px);
  }

  .footer-bottom {
    border-block-start: 1px solid rgba(255, 255, 255, 0.1);
    padding-block-start: var(--size-4);
    font-size: var(--font-size-1);
    opacity: 0.7;
  }

  .text-small {
    font-size: var(--font-size-1);
  }

  @media (max-width: 1024px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 640px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
