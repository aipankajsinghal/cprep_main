---
const { type, data } = Astro.props as { type: 'Organization' | 'WebSite' | 'FAQPage' | 'Course' | 'BreadcrumbList' | 'Article'; data: Record<string, unknown> };

const schema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": type,
  ...data
});
---

<script type="application/ld+json" set:html={schema} />
