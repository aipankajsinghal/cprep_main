---
interface Testimonial {
  author: string;
  role: string;
  content: string;
  image?: string;
  rating: number;
}

interface Props {
  data?: Testimonial[];
}

const defaultTestimonials = [
  {
    author: "Priya S.",
    role: "Was scoring 62 → Final exam: 94 (Accounts)",
    content:
      "Spent ₹500 for 3 chapters. Got corrections in 30 seconds that my tutor usually took 2-3 days to provide. That saved me 2 weeks of wasted time before finals.",
    rating: 5,
  },
  {
    author: "Rahul M.",
    role: "Economics mock: 58 → 82 (3 weeks later)",
    content:
      "I tried 4 other platforms. ChampionsPrep's AI actually identifies my weak topics and assigns practice automatically. No more generic problems. Actual improvement.",
    rating: 5,
  },
  {
    author: "Neha G. (Parent)",
    role: "Daughter averaged 71 → 87 in Econ",
    content:
      "I see exactly which topics my daughter is struggling with via the parent dashboard. Clear ROI—spent ₹800 instead of ₹5000/month on local tutoring. Results in 1 month.",
    rating: 5,
  },
];

const { data = defaultTestimonials } = Astro.props as Props;

const getInitials = (name: string) =>
  name
    .split(" ")
    .filter(Boolean)
    .slice(0, 2)
    .map((part) => part[0]?.toUpperCase() || "")
    .join("");
---

<section class="section-white">
  <div class="container">
    <div class="text-center mb-5" data-aos="fade-up">
      <h2 class="section-heading mb-3">What Our Students Say</h2>
      <p class="section-subtitle mx-auto">
        See how students are transforming their commerce studies with
        ChampionsPrep.
      </p>
    </div>

    <div class="grid grid-3 testimonial-grid">
      {
        data.map((t, index) => (
          <div
            class="card testimonial-card"
            data-aos="fade-up"
            data-aos-delay={index * 100}
          >
            <div class="testimonial-content">
              <svg
                class="quote-icon mb-4"
                xmlns="http://www.w3.org/2000/svg"
                width="32"
                height="32"
                viewBox="0 0 24 24"
                fill="currentColor"
                opacity="0.1"
              >
                <path d="M14.017 21L14.017 18C14.017 16.8954 14.9124 16 16.017 16H19.017C19.5693 16 20.017 15.5523 20.017 15V9C20.017 8.44772 19.5693 8 19.017 8H16.017C15.4647 8 15.017 8.44772 15.017 9V12C15.017 12.5523 14.5693 13 14.017 13H13.017V21H14.017ZM6.017 21L6.017 18C6.017 16.8954 6.91243 16 8.017 16H11.017C11.5693 16 12.017 15.5523 12.017 15V9C12.017 8.44772 11.5693 8 11.017 8H8.017C7.46472 8 7.017 8.44772 7.017 9V12C7.017 12.5523 6.56929 13 6.017 13H5.017V21H6.017Z" />
              </svg>
              <div class="rating mb-3">
                {"⭐".repeat(Math.floor(t.rating || 0))}
              </div>
              <p class="mb-4 text-italic">"{t.content}"</p>
            </div>
            <div class="testimonial-author flex">
              {t.image && (
                <img
                  src={t.image}
                  alt={t.author}
                  class="avatar-image"
                  loading="lazy"
                />
              )}
              {!t.image && (
                <div class="avatar">{getInitials(t.author)}</div>
              )}
              <div class="author-info">
                <div class="author-name">{t.author}</div>
                <div class="author-location">{t.role}</div>
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .section-heading {
    text-wrap: balance;
  }

  .section-subtitle {
    max-width: 640px;
    text-wrap: pretty;
  }

  .testimonial-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    border-bottom: 4px solid var(--cp-purple-deep);
  }

  .text-italic {
    font-style: italic;
    color: var(--cp-slate-medium);
  }

  .avatar {
    width: 48px;
    height: 48px;
    background-color: var(--cp-lavender);
    color: var(--cp-purple-deep);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    flex-shrink: 0;
  }

  .avatar-image {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
  }

  .author-name {
    font-weight: 700;
    color: var(--cp-slate-dark);
  }

  .author-location {
    font-size: var(--font-size-0);
    color: var(--cp-slate-medium);
  }

  .quote-icon {
    color: var(--cp-purple-deep);
  }

  .rating {
    line-height: 1;
  }

  @media (max-width: 640px) {
    .avatar,
    .avatar-image {
      width: 40px;
      height: 40px;
    }

    .author-location {
      font-size: 0.75rem;
    }
  }
</style>
