---
interface Props {
  url: string;
  title: string;
  postSlug: string;
  cluster: string;
  instagramId?: string;
}

const {
  url,
  title,
  postSlug,
  cluster,
  instagramId = "champions.prep"
} = Astro.props as Props;
const instagramHref = `https://www.instagram.com/${instagramId}/`;
---
<section class="share-section" aria-label="Share this article">
  <p class="share-section__title">Share this article</p>
  <div class="shareon" data-url={url} data-title={title} data-post-slug={postSlug}>
    <a class="whatsapp" aria-label="Share on WhatsApp"></a>
    <a class="twitter" aria-label="Share on X"></a>
    <a class="telegram" aria-label="Share on Telegram"></a>
    <a class="linkedin" aria-label="Share on LinkedIn"></a>
    <a
      class="instagram shareon-instagram"
      href={instagramHref}
      target="_blank"
      rel="noopener noreferrer"
      title={`Follow @${instagramId}`}
      aria-label="Open Instagram profile"
    >
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path
          d="M7.8 2h8.4A5.8 5.8 0 0 1 22 7.8v8.4a5.8 5.8 0 0 1-5.8 5.8H7.8A5.8 5.8 0 0 1 2 16.2V7.8A5.8 5.8 0 0 1 7.8 2Zm0 1.9A3.9 3.9 0 0 0 3.9 7.8v8.4a3.9 3.9 0 0 0 3.9 3.9h8.4a3.9 3.9 0 0 0 3.9-3.9V7.8a3.9 3.9 0 0 0-3.9-3.9Zm8.9 1.5a1.3 1.3 0 1 1 0 2.6 1.3 1.3 0 0 1 0-2.6Zm-4.7 1.4a5.2 5.2 0 1 1 0 10.4 5.2 5.2 0 0 1 0-10.4Zm0 1.9a3.3 3.3 0 1 0 0 6.6 3.3 3.3 0 0 0 0-6.6Z"
        ></path>
      </svg>
    </a>
    <button class="copy-url" type="button" aria-label="Copy article link"></button>
    <button class="web-share" type="button" aria-label="Open native share"></button>
  </div>
</section>

<script is:inline define:vars={{ postSlug, cluster }}>
  const shareContainer = document.querySelector(`.shareon[data-post-slug="${postSlug}"]`);
  if (shareContainer) {
    const platformSelector = [
      '[class*="whatsapp"]',
      '[class*="twitter"]',
      '[class*="telegram"]',
      '[class*="linkedin"]',
      '[class*="instagram"]',
      '[class*="copy-url"]',
      '[class*="web-share"]'
    ].join(", ");

    const knownPlatforms = ["whatsapp", "twitter", "telegram", "linkedin", "instagram", "copy-url", "web-share"];

    shareContainer.addEventListener("click", (event) => {
      const target = event.target;
      if (!(target instanceof HTMLElement)) return;
      const button = target.closest(platformSelector);
      if (!(button instanceof HTMLElement)) return;
      const platform = Array.from(button.classList).find((item) => knownPlatforms.includes(item)) ?? "unknown";

      if (typeof window.cpTrack === "function") {
        window.cpTrack("share_click", {
          platform,
          post_slug: postSlug,
          cluster
        });
      }
    });
  }
</script>

<style>
  .share-section {
    margin-top: var(--space-xl);
  }

  .share-section__title {
    margin: 0 0 0.5rem;
    color: var(--color-text-secondary);
    font-size: 0.9rem;
    font-weight: 600;
  }

  .shareon {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .shareon > * {
    border-radius: 999px !important;
    transition: transform 180ms ease, opacity 180ms ease !important;
    min-width: 2.6rem;
    min-height: 2.6rem;
  }

  .shareon > *:hover {
    transform: translateY(-1px) !important;
  }

  .shareon-instagram {
    display: inline-flex !important;
    align-items: center;
    justify-content: center;
    background: #e4405f !important;
    color: #fff !important;
    text-decoration: none;
  }

  .shareon-instagram svg {
    width: 1rem;
    height: 1rem;
    fill: currentColor;
  }

  .shareon button.web-share {
    display: none;
  }

  @supports (share-target: auto) {
    .shareon button.web-share {
      display: inline-flex;
    }
  }

  @media (hover: none) and (pointer: coarse) {
    .shareon button.web-share {
      display: inline-flex;
    }
  }

  @media (min-width: 640px) {
    .share-section__title {
      font-size: 0.95rem;
    }
  }

  @media (max-width: 640px) {
    .shareon > * {
      min-width: 48px;
      min-height: 48px;
    }
  }

</style>
