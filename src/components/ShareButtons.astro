---
interface Props {
  url: string;
  title: string;
  postSlug: string;
  cluster: string;
  instagramId?: string;
}

const {
  url,
  title,
  postSlug,
  cluster,
  instagramId = "champions.prep",
} = Astro.props as Props;
const instagramHref = `https://www.instagram.com/${instagramId}/`;
---

<section class="share-section" aria-label="Share this article">
  <p class="share-section__title">Share this article</p>
  <div
    class="shareon"
    data-url={url}
    data-title={title}
    data-post-slug={postSlug}
  >
    <a class="whatsapp" aria-label="Share on WhatsApp">
      <svg viewBox="0 0 24 24"
        ><path
          d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.038 3.284l-.569 2.1c-.149.546.455 1.033.947.817l2.121-.887c.688.309 1.426.465 2.228.465 3.181 0 5.767-2.586 5.768-5.77 0-3.18-2.585-5.775-5.765-5.775zm3.036 8.442c-.113.318-.656.57-1.02.603-.36.03-.788.056-2.318-.552-1.839-.731-3.035-2.613-3.126-2.734-.09-.12-.742-.988-.742-1.884 0-.895.451-1.332.612-1.512.16-.179.352-.224.47-.224.116 0 .232.002.332.006.106.005.25-.04.389.297.143.348.491 1.2.533 1.287.043.085.07.186.012.302-.058.114-.088.187-.175.289-.086.1-.183.224-.261.302-.09.09-.184.188-.079.369.103.18.459.757.985 1.226.677.602 1.246.789 1.427.88.181.09.288.076.395-.047.106-.123.456-.53.578-.71.121-.181.243-.153.409-.091.167.062 1.062.501 1.244.593.183.091.305.136.35.212.043.078.043.451-.07.771z"
        ></path></svg
      >
    </a>
    <a class="twitter" aria-label="Share on X">
      <svg viewBox="0 0 24 24"
        ><path
          d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"
        ></path></svg
      >
    </a>
    <a class="telegram" aria-label="Share on Telegram">
      <svg viewBox="0 0 24 24"
        ><path
          d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42.99-.68 1.02-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69a.2.2 0 00-.05-.18c-.06-.05-.14-.03-.21-.02-.09.02-1.49.95-4.22 2.79-.4.27-.76.41-1.08.4-.36-.01-1.04-.2-1.55-.37-.63-.2-1.12-.31-1.08-.66.02-.18.27-.36.74-.55 2.92-1.27 4.86-2.11 5.83-2.51 2.78-1.16 3.35-1.36 3.73-1.36.08 0 .27.02.39.12.1.08.13.19.14.27-.01.06.01.24 0 .33z"
        ></path></svg
      >
    </a>
    <a class="linkedin" aria-label="Share on LinkedIn">
      <svg viewBox="0 0 24 24"
        ><path
          d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a2.7 2.7 0 0 0-2.7-2.7c-1.2 0-2.3.7-2.7 1.8V10h-3v8.5h3v-4.8c0-.6.5-1.1 1.1-1.1.6 0 1.1.5 1.1 1.1v4.8h3M7 18.5V10h-3v8.5h3M5.5 4a1.5 1.5 0 0 0-1.5 1.5 1.5 1.5 0 0 0 1.5 1.5 1.5 1.5 0 0 0 1.5-1.5A1.5 1.5 0 0 0 5.5 4z"
        ></path></svg
      >
    </a>
    <a
      class="instagram shareon-instagram"
      href={instagramHref}
      target="_blank"
      rel="noopener noreferrer"
      title={`Follow @${instagramId}`}
      aria-label="Open Instagram profile"
    >
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path
          d="M7.8 2h8.4A5.8 5.8 0 0 1 22 7.8v8.4a5.8 5.8 0 0 1-5.8 5.8H7.8A5.8 5.8 0 0 1 2 16.2V7.8A5.8 5.8 0 0 1 7.8 2Zm0 1.9A3.9 3.9 0 0 0 3.9 7.8v8.4a3.9 3.9 0 0 0 3.9 3.9h8.4a3.9 3.9 0 0 0 3.9-3.9V7.8a3.9 3.9 0 0 0-3.9-3.9Zm8.9 1.5a1.3 1.3 0 1 1 0 2.6 1.3 1.3 0 0 1 0-2.6Zm-4.7 1.4a5.2 5.2 0 1 1 0 10.4 5.2 5.2 0 0 1 0-10.4Zm0 1.9a3.3 3.3 0 1 0 0 6.6 3.3 3.3 0 0 0 0-6.6Z"
        ></path>
      </svg>
    </a>
    <button class="copy-url" type="button" aria-label="Copy article link">
      <svg viewBox="0 0 24 24"
        ><path
          d="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z"
        ></path></svg
      >
    </button>
    <button class="web-share" type="button" aria-label="Open native share">
      <svg viewBox="0 0 24 24"
        ><path
          d="M18 16.08c-.76 0-1.44.3-1.96.77L8.91 12.7c.05-.23.09-.46.09-.7s-.04-.47-.09-.7l7.05-4.11c.54.5 1.25.81 2.04.81 1.66 0 3-1.34 3-3s-1.34-3-3-3-3 1.34-3 3c0 .24.04.47.09.7L8.04 9.81C7.5 9.31 6.79 9 6 9c-1.66 0-3 1.34-3 3s1.34 3 3 3c.79 0 1.5-.31 2.04-.81l7.12 4.16c-.05.21-.08.43-.08.65 0 1.61 1.31 2.92 2.92 2.92 1.61 0 2.92-1.31 2.92-2.92s-1.31-2.92-2.92-2.92z"
        ></path></svg
      >
    </button>
  </div>
</section>

<script is:inline define:vars={{ postSlug, cluster }}>
  const shareContainer = document.querySelector(
    `.shareon[data-post-slug="${postSlug}"]`,
  );
  if (shareContainer) {
    const platformSelector = [
      '[class*="whatsapp"]',
      '[class*="twitter"]',
      '[class*="telegram"]',
      '[class*="linkedin"]',
      '[class*="instagram"]',
      '[class*="copy-url"]',
      '[class*="web-share"]',
    ].join(", ");

    const knownPlatforms = [
      "whatsapp",
      "twitter",
      "telegram",
      "linkedin",
      "instagram",
      "copy-url",
      "web-share",
    ];

    shareContainer.addEventListener("click", (event) => {
      const target = event.target;
      if (!(target instanceof HTMLElement)) return;
      const button = target.closest(platformSelector);
      if (!(button instanceof HTMLElement)) return;
      const platform =
        Array.from(button.classList).find((item) =>
          knownPlatforms.includes(item),
        ) ?? "unknown";

      // Show toast confirmation when the user copies the link
      if (platform === "copy-url" && typeof window.cpToast === "function") {
        setTimeout(() => window.cpToast("Link copied!"), 120);
      }

      if (typeof window.cpTrack === "function") {
        window.cpTrack("share_click", {
          platform,
          post_slug: postSlug,
          cluster,
        });
      }
    });
  }
</script>

<style>
  .share-section {
    margin-top: var(--space-xl);
  }

  .share-section__title {
    margin: 0 0 0.75rem;
    color: var(--color-text-secondary);
    font-size: 0.9rem;
    font-weight: 600;
  }

  .shareon {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
  }

  .shareon > * {
    display: inline-flex !important;
    align-items: center;
    justify-content: center;
    border-radius: 999px !important;
    transition: all 220ms cubic-bezier(0.4, 0, 0.2, 1) !important;
    min-width: 2.8rem;
    min-height: 2.8rem;
    padding: 0;
    margin: 0;
    border: 1px solid var(--color-border);
    background: var(--color-bg-warm) !important;
    color: var(--color-purple-deep) !important;
    cursor: pointer;
    text-decoration: none;
    box-shadow: none !important;
  }

  /* Remove shareon default background images */
  .shareon > *::before,
  .shareon > *::after {
    display: none !important;
  }

  .shareon svg {
    width: 1.15rem;
    height: 1.15rem;
    fill: currentColor;
    transition: transform 220ms ease;
  }

  .shareon > *:hover {
    transform: translateY(-2px) !important;
    background: var(--color-purple-deep) !important;
    color: #fff !important;
    border-color: var(--color-purple-deep);
    box-shadow: 0 4px 12px
      color-mix(in srgb, var(--color-purple-deep), transparent 75%) !important;
  }

  .shareon > *:hover svg {
    transform: scale(1.1);
  }

  /* Specific background for Instagram to maintain brand feel but still cohesive */
  .shareon-instagram:hover {
    background: #e4405f !important;
    border-color: #e4405f;
    box-shadow: 0 4px 12px rgba(228, 64, 95, 0.25) !important;
  }

  .shareon button.web-share {
    display: none;
  }

  @supports (share-target: auto) {
    .shareon button.web-share {
      display: inline-flex;
    }
  }

  @media (hover: none) and (pointer: coarse) {
    .shareon button.web-share {
      display: inline-flex;
    }
  }

  @media (min-width: 640px) {
    .share-section__title {
      font-size: 0.95rem;
    }
  }

  @media (max-width: 640px) {
    .shareon > * {
      min-width: 48px;
      min-height: 48px;
    }
  }
</style>
