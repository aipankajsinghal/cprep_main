---
import { sanityClient } from "../lib/sanity";
import { ALL_POSTS_QUERY } from "../lib/queries";
import { clusterLabel } from "../utils/clusters";

interface Props {
  currentSlug: string;
  cluster: string;
  tags: Array<{ title: string; slug: string }>;
  limit?: number;
}

const { currentSlug, cluster, tags, limit = 3 } = Astro.props as Props;
const tagSlugs = new Set(tags.map((t) => t.slug));

const now = new Date();
const allPosts = (await sanityClient.fetch(ALL_POSTS_QUERY)).filter(
  (p: any) => !p.publishDate || new Date(p.publishDate) <= now,
);

const candidates = allPosts.filter((p: any) => p.slug !== currentSlug);

const scored = candidates
  .map((post: any) => {
    let score = 0;
    if (post.cluster === cluster) score += 3;
    const postTags =
      (post.tags as Array<{ title: string; slug: string }>) ?? [];
    for (const tagObj of postTags) {
      if (tagSlugs.has(tagObj.slug)) score += 1;
    }
    return { post, score };
  })
  .sort((a: any, b: any) => {
    if (b.score !== a.score) return b.score - a.score;
    return new Date(b.post.date).getTime() - new Date(a.post.date).getTime();
  });

const selected: typeof scored = [];
for (const item of scored) {
  if (selected.length >= limit) break;
  if (item.score > 0) selected.push(item);
}
if (selected.length < limit) {
  for (const item of scored) {
    if (selected.length >= limit) break;
    if (!selected.some((picked: any) => picked.post.slug === item.post.slug)) {
      selected.push(item);
    }
  }
}

const relatedItems = selected.map(({ post }: any) => ({
  slug: post.slug,
  title: post.title,
  cluster: post.cluster,
  clusterDisplay: clusterLabel(post.cluster),
  dateLabel: new Date(post.date).toLocaleDateString("en-IN", {
    month: "short",
    day: "numeric",
  }),
  minutesRead: post.minutesRead ?? 5,
}));
---

<section class="related-posts" aria-label="Related posts">
  <div class="related-posts__header">
    <span class="related-posts__rule" aria-hidden="true"></span>
    <h2 class="related-posts__heading">From the Desk</h2>
    <span class="related-posts__rule" aria-hidden="true"></span>
  </div>

  {
    relatedItems.length === 0 ? (
      <p class="related-posts__empty">No related posts yet.</p>
    ) : (
      <div class="related-posts__grid">
        {relatedItems.map((item) => (
          <a
            href={`/blog/${item.slug}/`}
            class="related-posts__card"
            data-cluster={item.cluster}
          >
            <div class="related-posts__accent" aria-hidden="true" />
            <span class="related-posts__cluster">{item.clusterDisplay}</span>
            <span class="related-posts__title">{item.title}</span>
            <span class="related-posts__meta">
              {item.dateLabel} · {item.minutesRead} min
            </span>
          </a>
        ))}
      </div>
    )
  }
</section>

<style>
  .related-posts {
    margin-top: var(--space-xl);
  }

  .related-posts__header {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .related-posts__rule {
    flex: 1;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent,
      var(--color-border) 30%,
      var(--color-border) 70%,
      transparent
    );
  }

  .related-posts__heading {
    margin: 0;
    font-family: var(--font-display);
    font-size: 0.88rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
    white-space: nowrap;
  }

  .related-posts__empty {
    margin: 0;
    color: var(--color-text-secondary);
    text-align: center;
    padding: 2rem 0;
  }

  .related-posts__grid {
    display: grid;
    gap: 1rem;
  }

  .related-posts__card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 1.1rem 1rem 1rem;
    border-radius: var(--shape-radius);
    background: var(--color-bg);
    border: 1px solid color-mix(in srgb, var(--color-border), transparent 30%);
    text-decoration: none;
    overflow: hidden;
    transition:
      border-color 180ms ease,
      transform 180ms ease,
      background 180ms ease;
  }

  .related-posts__card:hover {
    border-color: var(--color-border-accent);
    transform: var(--transform-lift);
    background: var(--color-bg-muted);
  }

  /* Cluster-coloured top accent line */
  .related-posts__accent {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: var(--color-purple-deep);
  }

  .related-posts__card[data-cluster="taxation"] .related-posts__accent {
    background: #e07c3e;
  }
  .related-posts__card[data-cluster="accountancy"] .related-posts__accent {
    background: #4a90d9;
  }
  .related-posts__card[data-cluster="business-studies"] .related-posts__accent {
    background: #5da55d;
  }
  .related-posts__card[data-cluster="economics"] .related-posts__accent {
    background: #d4af37;
  }
  .related-posts__card[data-cluster="corporate-law"] .related-posts__accent {
    background: #c0392b;
  }
  .related-posts__card[data-cluster="tips-tricks"] .related-posts__accent {
    background: #16a085;
  }
  .related-posts__card[data-cluster="shortcuts"] .related-posts__accent {
    background: #f39c12;
  }
  .related-posts__card[data-cluster="mindmaps"] .related-posts__accent {
    background: #8e44ad;
  }
  .related-posts__card[data-cluster="quick-quiz"] .related-posts__accent {
    background: #2980b9;
  }

  .related-posts__cluster {
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-purple-deep);
    font-weight: 700;
  }

  .related-posts__title {
    color: var(--color-text-heading);
    font-weight: 600;
    font-size: 0.96rem;
    line-height: 1.35;
    font-family: var(--font-display);
  }

  .related-posts__meta {
    font-size: 0.78rem;
    color: var(--color-text-secondary);
    margin-top: 0.1rem;
  }

  @media (min-width: 640px) {
    .related-posts__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
