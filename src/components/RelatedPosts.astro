---
import { getCollection } from "astro:content";
import { clusterLabel } from "../utils/clusters";
import { calculateMinutesRead } from "../utils/content";

interface Props {
  currentSlug: string;
  cluster: string;
  tags: string[];
  limit?: number;
}

const { currentSlug, cluster, tags, limit = 3 } = Astro.props as Props;
const tagSet = new Set(tags);

const candidates = (await getCollection("blog", ({ data }) => !data.draft)).filter(
  (post) => post.slug !== currentSlug
);

const scored = candidates
  .map((post) => {
    let score = 0;
    if (post.data.cluster === cluster) score += 3;
    for (const tag of post.data.tags) {
      if (tagSet.has(tag)) score += 1;
    }
    return { post, score };
  })
  .sort((a, b) => {
    if (b.score !== a.score) return b.score - a.score;
    return b.post.data.date.getTime() - a.post.data.date.getTime();
  });

const selected: typeof scored = [];
for (const item of scored) {
  if (selected.length >= limit) break;
  if (item.score > 0) selected.push(item);
}
if (selected.length < limit) {
  for (const item of scored) {
    if (selected.length >= limit) break;
    if (!selected.some((picked) => picked.post.slug === item.post.slug)) {
      selected.push(item);
    }
  }
}

const relatedItems = selected.map(({ post }) => ({
  slug: post.slug,
  title: post.data.title,
  cluster: clusterLabel(post.data.cluster),
  dateLabel: post.data.date.toLocaleDateString("en-IN", { month: "short", day: "numeric" }),
  minutesRead: post.data.minutesRead ?? calculateMinutesRead(post.body)
}));
---
<section class="related-posts" aria-label="Related posts">
  <h2>Continue Reading</h2>
  {relatedItems.length === 0 ? (
    <p class="related-posts__empty">No related posts yet.</p>
  ) : (
    <div class="related-posts__grid">
      {relatedItems.map((item) => (
        <a href={`/blog/${item.slug}/`} class="related-posts__card">
          <span class="related-posts__cluster">{item.cluster}</span>
          <span class="related-posts__title">{item.title}</span>
          <span class="related-posts__meta">{item.dateLabel} · {item.minutesRead} min read</span>
        </a>
      ))}
    </div>
  )}
</section>

<style>
  .related-posts {
    margin-top: var(--space-xl);
  }

  .related-posts__grid {
    margin-top: 1rem;
    display: grid;
    gap: 0.75rem;
  }

  .related-posts__empty {
    margin: 0.75rem 0 0;
    color: var(--color-text-secondary);
  }

  .related-posts__empty::before {
    content: "◇";
    margin-right: 0.45rem;
    color: var(--color-purple-deep);
    opacity: 0.45;
  }

  .related-posts__card {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 0.95rem;
    border: 1px solid var(--color-border);
    border-radius: var(--shape-radius);
    background: var(--color-bg);
    text-decoration: none;
    transition: border-color 180ms ease, transform 180ms ease, box-shadow 180ms ease;
  }

  .related-posts__card:hover {
    border-color: var(--color-border-accent);
    transform: translateY(-2px);
    box-shadow: 0 8px 20px color-mix(in srgb, var(--color-purple-deep), transparent 92%);
  }

  .related-posts__cluster {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-purple-deep);
    font-weight: 700;
  }

  .related-posts__title {
    color: var(--color-text-heading);
    font-weight: 600;
    line-height: 1.3;
  }

  .related-posts__meta {
    font-size: 0.8rem;
    color: var(--color-text-secondary);
  }

  @media (min-width: 640px) {
    .related-posts__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
