---
interface Props {
  href?: string;
  cluster?: string;
  postSlug?: string;
  midLabel?: string;
  endLabel?: string;
}

const {
  href = "https://www.championsprep.in/",
  cluster = "",
  postSlug = "",
  midLabel = "Want structured guidance for this topic?",
  endLabel = "Liked this insight? Explore full study resources built for Class 11-12 Commerce.",
} = Astro.props as Props;
---

<!-- Mid-article CTA: inline, revealed at scroll 40% -->
<aside class="smart-cta smart-cta--mid" data-smart-cta-mid hidden aria-label="Mid-article call to action">
  <div class="smart-cta__rule" aria-hidden="true"></div>
  <div class="smart-cta__inner">
    <p class="smart-cta__eyebrow">ChampionsPrep</p>
    <p class="smart-cta__text">{midLabel}</p>
    <a href={href} data-smart-cta-link data-position="mid" class="smart-cta__link">
      Get a prep plan <span aria-hidden="true">→</span>
    </a>
  </div>
  <div class="smart-cta__rule" aria-hidden="true"></div>
</aside>

<!-- End-of-article CTA -->
<aside class="smart-cta smart-cta--end" aria-label="End of article call to action">
  <div class="smart-cta__inner">
    <p class="smart-cta__eyebrow">ChampionsPrep</p>
    <p class="smart-cta__headline">{endLabel}</p>
    <a href={href} data-smart-cta-link data-position="end" class="smart-cta__link smart-cta__link--end">
      Explore study resources <span aria-hidden="true">→</span>
    </a>
  </div>
</aside>

<script is:inline define:vars={{ postSlug, cluster }}>
  const mid = document.querySelector("[data-smart-cta-mid]");
  const postBody = document.querySelector(".post-body");

  if (mid instanceof HTMLElement && postBody instanceof HTMLElement) {
    if (getComputedStyle(postBody).position === "static") {
      postBody.style.position = "relative";
    }

    const marker = document.createElement("span");
    marker.setAttribute("aria-hidden", "true");
    marker.style.position = "absolute";
    marker.style.top = "40%";
    marker.style.left = "0";
    marker.style.width = "1px";
    marker.style.height = "1px";
    postBody.append(marker);

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          mid.hidden = false;
          observer.disconnect();
        }
      },
      { rootMargin: "0px 0px -15% 0px", threshold: 0 }
    );

    observer.observe(marker);
  }

  const ctaLinks = Array.from(document.querySelectorAll("[data-smart-cta-link]"));
  for (const link of ctaLinks) {
    if (!(link instanceof HTMLAnchorElement)) continue;
    link.addEventListener("click", () => {
      const position = link.getAttribute("data-position");
      if (!position) return;
      if (typeof window.cpTrack === "function") {
        window.cpTrack("cta_click", {
          post_slug: postSlug,
          cluster,
          position,
        });
      }
    });
  }
</script>

<style>
  .smart-cta {
    margin: var(--space-xl) 0;
  }

  .smart-cta__rule {
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent,
      var(--color-border) 25%,
      var(--color-purple-deep) 50%,
      var(--color-border) 75%,
      transparent
    );
    margin: 1.4rem 0;
  }

  .smart-cta__inner {
    text-align: center;
    padding: 0 1rem;
  }

  .smart-cta__eyebrow {
    margin: 0 0 0.5rem;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-purple-deep);
  }

  .smart-cta__text {
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(1.05rem, 1.6vw, 1.22rem);
    color: var(--color-text-heading);
    line-height: 1.5;
    max-width: 52ch;
    margin: 0 auto 0.9rem;
  }

  .smart-cta__headline {
    font-family: var(--font-display);
    font-size: clamp(1.05rem, 1.8vw, 1.3rem);
    color: var(--color-text-heading);
    line-height: 1.45;
    max-width: 56ch;
    margin: 0 auto 1rem;
  }

  .smart-cta__link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.55rem 1.3rem;
    border: 1.5px solid var(--color-purple-deep);
    border-radius: 999px;
    background: transparent;
    color: var(--color-purple-deep);
    text-decoration: none;
    font-weight: 700;
    font-size: 0.88rem;
    letter-spacing: 0.02em;
    transition: background var(--transition-base), color var(--transition-base), transform var(--transition-base);
  }

  .smart-cta__link:hover {
    background: var(--color-purple-deep);
    color: #ffffff;
    transform: var(--transform-lift-sm);
  }

  .smart-cta__link--end {
    padding: 0.6rem 1.6rem;
    font-size: 0.92rem;
  }

  /* End CTA: contained editorial box */
  .smart-cta--end .smart-cta__inner {
    border: 1px solid color-mix(in srgb, var(--color-border), transparent 20%);
    border-radius: var(--shape-radius);
    padding: 1.8rem 1.5rem;
    background: color-mix(in srgb, var(--color-purple-soft), transparent 60%);
  }

  html.dark .smart-cta--end .smart-cta__inner {
    background: color-mix(in srgb, var(--color-lavender-light), transparent 50%);
  }
</style>
