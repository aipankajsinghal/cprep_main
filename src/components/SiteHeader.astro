---
import siteSettings from "../data/site-settings.json";

interface TagLink {
  slug: string;
  label: string;
}

interface Props {
  tags?: TagLink[];
}

const { tags = [] } = Astro.props as Props;
const mainSiteUrl = String(siteSettings.mainSiteUrl ?? "https://www.championsprep.in/");
const isMainSiteExternal = /^https?:\/\//i.test(mainSiteUrl);
---
<div class="site-masthead" aria-label="Publication information">
  <div class="site-masthead__inner">
    <span class="site-masthead__topics">Commerce · Strategy · Revision</span>
    <span class="site-masthead__tagline">Insights for Class 11-12</span>
  </div>
</div>
<header class="site-header">
  <div class="site-header__inner">
    <a href="/blog/" class="site-header__brand">
      <img src="/icons/insights-logo.svg" alt="Insights by ChampionsPrep" class="site-header__logo" width="180" height="44" />
    </a>

    <button
      class="site-header__menu-toggle"
      type="button"
      data-nav-toggle
      aria-expanded="false"
      aria-controls="site-nav"
      aria-label="Toggle navigation menu"
    >
      <span class="site-header__menu-icon" aria-hidden="true"></span>
      <span class="site-header__menu-label">Menu</span>
    </button>

    <nav id="site-nav" class="site-header__nav" data-site-nav aria-hidden="true" inert>
      <a href="/blog/">Blog</a>
      <a
        href={mainSiteUrl}
        target={isMainSiteExternal ? "_blank" : undefined}
        rel={isMainSiteExternal ? "noopener noreferrer" : undefined}
      >
        Main Site
      </a>
      {tags.length > 0 && (
        <details class="site-header__tags">
          <summary>Tags</summary>
          <div class="site-header__tag-list">
            {tags.map((tag) => (
              <a href={`/blog/tag/${tag.slug}/`}>{tag.label}</a>
            ))}
          </div>
        </details>
      )}
      <button class="site-header__theme-toggle" type="button" data-theme-toggle aria-label="Toggle dark mode">
        Dark Mode
      </button>
    </nav>
    <button
      class="site-header__backdrop"
      type="button"
      data-nav-backdrop
      aria-label="Close navigation menu"
      aria-hidden="true"
      hidden
    ></button>
  </div>
</header>

<script is:inline>
  (() => {
    const nav = document.querySelector("[data-site-nav]");
    const toggle = document.querySelector("[data-nav-toggle]");
    const backdrop = document.querySelector("[data-nav-backdrop]");
    if (
      !(nav instanceof HTMLElement) ||
      !(toggle instanceof HTMLButtonElement) ||
      !(backdrop instanceof HTMLButtonElement)
    ) {
      return;
    }

    const desktopQuery = window.matchMedia("(min-width: 900px)");
    let restoreFocus = false;
    const focusableSelector = [
      "a[href]",
      "button:not([disabled])",
      "summary",
      "[tabindex]:not([tabindex='-1'])"
    ].join(", ");

    const getFocusable = () =>
      Array.from(nav.querySelectorAll(focusableSelector)).filter(
        (el) => el instanceof HTMLElement && !el.hasAttribute("disabled") && !el.getAttribute("aria-hidden")
      );

    const openNav = (shouldRestoreFocus = false) => {
      if (desktopQuery.matches) return;
      restoreFocus = shouldRestoreFocus;
      nav.dataset.open = "true";
      nav.removeAttribute("inert");
      nav.setAttribute("aria-hidden", "false");
      backdrop.hidden = false;
      backdrop.setAttribute("aria-hidden", "false");
      document.body.classList.add("nav-open");
      toggle.setAttribute("aria-expanded", "true");

      const focusables = getFocusable();
      const first = focusables[0];
      if (first instanceof HTMLElement) {
        first.focus();
      }
    };

    const closeNav = () => {
      nav.dataset.open = "false";
      nav.setAttribute("inert", "");
      nav.setAttribute("aria-hidden", "true");
      backdrop.hidden = true;
      backdrop.setAttribute("aria-hidden", "true");
      document.body.classList.remove("nav-open");
      toggle.setAttribute("aria-expanded", "false");

      if (restoreFocus) {
        toggle.focus();
      }
      restoreFocus = false;
    };

    const applyViewportState = () => {
      if (desktopQuery.matches) {
        nav.dataset.open = "true";
        nav.removeAttribute("inert");
        nav.setAttribute("aria-hidden", "false");
        backdrop.hidden = true;
        backdrop.setAttribute("aria-hidden", "true");
        document.body.classList.remove("nav-open");
        toggle.setAttribute("aria-expanded", "false");
        return;
      }

      closeNav();
    };

    toggle.addEventListener("click", () => {
      if (desktopQuery.matches) return;
      if (nav.dataset.open === "true") {
        closeNav();
      } else {
        openNav(true);
      }
    });

    backdrop.addEventListener("click", () => {
      closeNav();
    });

    nav.addEventListener("click", (event) => {
      const target = event.target;
      if (!(target instanceof HTMLElement)) return;
      if (target.closest("a") && !desktopQuery.matches) {
        closeNav();
      }
    });

    document.addEventListener("keydown", (event) => {
      if (desktopQuery.matches || nav.dataset.open !== "true") return;
      if (event.key === "Escape") {
        event.preventDefault();
        closeNav();
        return;
      }

      if (event.key !== "Tab") return;
      const focusables = getFocusable();
      if (focusables.length === 0) return;
      const first = focusables[0];
      const last = focusables[focusables.length - 1];
      if (!(first instanceof HTMLElement) || !(last instanceof HTMLElement)) return;

      const active = document.activeElement;
      if (event.shiftKey && active === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && active === last) {
        event.preventDefault();
        first.focus();
      }
    });

    desktopQuery.addEventListener("change", applyViewportState);
    applyViewportState();
  })();
</script>

<style>
  /* Publication masthead strip */
  .site-masthead {
    background: var(--color-purple-deep);
    color: #ffffff;
  }

  .site-masthead__inner {
    width: min(100% - 2rem, 1120px);
    margin-inline: auto;
    padding: 0.28rem 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .site-masthead__topics {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    opacity: 0.9;
  }

  .site-masthead__tagline {
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    opacity: 0.72;
    font-style: italic;
    font-family: var(--font-display);
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 80;
    border-bottom: 1px solid var(--color-border);
    background: color-mix(in srgb, var(--color-bg-warm), transparent 6%);
    backdrop-filter: blur(6px);
  }

  .site-header__inner {
    position: relative;
    width: min(100% - 2rem, 1120px);
    margin-inline: auto;
    padding: 0.8rem 0;
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 0.85rem;
  }

  .site-header__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--color-text-heading);
    text-decoration: none;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .site-header__brand-mark {
    width: 0.72rem;
    height: 0.72rem;
    flex: 0 0 0.72rem;
    transform: rotate(45deg);
    border-radius: 2px;
    background: var(--color-purple-deep);
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--color-purple-deep), white 45%);
  }

  .site-header__logo {
    display: inline-block;
    width: auto;
    height: 44px;
    max-width: 220px;
    object-fit: contain;
  }

  .site-header__menu-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    appearance: none;
    border: 1px solid var(--color-border);
    border-radius: 12px;
    background: var(--color-bg);
    color: var(--color-text-primary);
    min-width: 44px;
    min-height: 44px;
    padding: 0.38rem 0.7rem;
    font: inherit;
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
  }

  .site-header__nav {
    position: fixed;
    inset: 0 0 0 auto;
    width: min(88vw, 340px);
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    border-left: 1px solid var(--color-border);
    border-radius: 0;
    background: color-mix(in srgb, var(--color-bg), transparent 5%);
    backdrop-filter: blur(18px);
    padding: 5rem 1.25rem 1.5rem;
    box-shadow: -16px 0 28px color-mix(in srgb, var(--color-purple-deep), transparent 90%);
    transform: translateX(100%);
    transition: transform 260ms ease;
  }

  .site-header__nav[data-open="true"] {
    transform: translateX(0);
  }

  .site-header__backdrop {
    position: fixed;
    inset: 0;
    z-index: 1;
    border: 0;
    background: color-mix(in srgb, #000, transparent 45%);
    cursor: pointer;
  }

  .site-header__nav a,
  .site-header__theme-toggle,
  .site-header__tags summary {
    font-size: 1.05rem;
    color: var(--color-text-primary);
    text-decoration: none;
    font-weight: 600;
  }

  .site-header__theme-toggle {
    appearance: none;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: var(--color-bg);
    padding: 0.34rem 0.78rem;
    font: inherit;
    cursor: pointer;
    width: fit-content;
  }

  .site-header__menu-icon {
    position: relative;
    display: inline-block;
    width: 16px;
    height: 12px;
    border-top: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
  }

  .site-header__menu-icon::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    top: 4px;
    border-top: 2px solid currentColor;
  }

  .site-header__menu-label {
    line-height: 1;
  }

  .site-header__tags summary {
    list-style: none;
    cursor: pointer;
  }

  .site-header__tags summary::-webkit-details-marker {
    display: none;
  }

  .site-header__tag-list {
    margin-top: 0.5rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .site-header__tag-list a {
    border: 1px solid var(--color-border);
    border-radius: 999px;
    padding: 0.22rem 0.58rem;
    background: var(--color-bg);
    font-size: 0.8rem;
  }

  @media (min-width: 900px) {
    .site-header__inner {
      grid-template-columns: auto 1fr;
      gap: 1rem;
      padding: 0.9rem 0;
    }

    .site-header__menu-toggle {
      display: none;
    }

    .site-header__nav {
      grid-column: auto;
      position: static;
      display: flex !important;
      flex-direction: row;
      align-items: center;
      justify-content: flex-end;
      flex-wrap: wrap;
      border-top: 0;
      border: 0;
      border-radius: 0;
      box-shadow: none;
      backdrop-filter: none;
      background: transparent;
      transform: none;
      transition: none;
      width: auto;
      inset: auto;
      padding-top: 0;
      padding: 0;
      gap: 0.9rem;
    }

    .site-header__nav a,
    .site-header__theme-toggle,
    .site-header__tags summary {
      font-size: 0.92rem;
    }

    .site-header__backdrop {
      display: none !important;
    }

    .site-header__tags {
      position: relative;
    }

    .site-header__tag-list {
      position: absolute;
      top: calc(100% + 0.45rem);
      right: 0;
      min-width: 260px;
      background: var(--color-bg);
      border: 1px solid var(--color-border);
      border-radius: var(--shape-radius);
      padding: 0.65rem;
      box-shadow: 0 14px 30px color-mix(in srgb, var(--color-purple-deep), transparent 90%);
    }
  }
</style>
