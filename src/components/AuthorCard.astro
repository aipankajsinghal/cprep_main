---
interface Props {
  name: string;
  bio?: string;
  avatar?: string;
}

const {
  name,
  bio = "ChampionsPrep editorial team",
  avatar
} = Astro.props as Props;
---
<section class="author-card" aria-label="Author information">
  {avatar ? <img class="author-card__avatar" src={avatar} alt={`${name} avatar`} loading="lazy" /> : null}
  <div class="author-card__content">
    <h3 class="author-card__name">{name}</h3>
    <p class="author-card__bio">{bio}</p>
  </div>
</section>

<style>
  .author-card {
    margin: 2rem 0 0;
    border: 1px solid var(--color-border);
    border-radius: var(--shape-radius);
    padding: 0.9rem 1rem;
    display: flex;
    align-items: center;
    gap: 0.8rem;
    background: var(--color-bg-muted);
    transition: border-color 180ms ease, transform 180ms ease;
  }

  .author-card:hover {
    border-color: var(--color-lavender-500);
    transform: translateY(-1px);
  }

  .author-card__avatar {
    width: 3rem;
    height: 3rem;
    border-radius: 999px;
    object-fit: cover;
    flex: 0 0 3rem;
  }

  .author-card__name {
    margin: 0;
    font-size: 1rem;
    line-height: 1.3;
  }

  .author-card__bio {
    margin: 0.25rem 0 0;
    color: var(--color-text-secondary);
  }
</style>
