---
interface Props {
  name: string;
  bio?: string;
  avatar?: string;
  role?: string;
}

const {
  name,
  bio = "Crafting clear, exam-focused insights for Class 11-12 Commerce students.",
  avatar,
  role = "Commerce Faculty · ChampionsPrep",
} = Astro.props as Props;

const initials = name
  .split(" ")
  .map((n: string) => n[0] ?? "")
  .join("")
  .toUpperCase()
  .slice(0, 2);
---
<section class="author-card" aria-label="Author information">
  <div class="author-card__avatar-wrap">
    {avatar
      ? <img class="author-card__avatar" src={avatar} alt={name} loading="lazy" />
      : <div class="author-card__initials" aria-hidden="true">{initials}</div>
    }
  </div>
  <div class="author-card__content">
    <div class="author-card__name-row">
      <h3 class="author-card__name">{name}</h3>
      <span class="author-card__badge">&#10003; Verified</span>
    </div>
    <p class="author-card__role">{role}</p>
    <p class="author-card__bio">{bio}</p>
  </div>
</section>

<style>
  .author-card {
    margin: 2rem 0 0;
    border: 1px solid color-mix(in srgb, var(--color-border), transparent 25%);
    border-top: 3px solid var(--color-purple-deep);
    border-radius: var(--shape-radius);
    padding: 1.1rem 1.2rem;
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    background: var(--color-bg-muted);
  }

  .author-card__avatar-wrap {
    flex: 0 0 auto;
  }

  .author-card__avatar {
    width: 3.2rem;
    height: 3.2rem;
    border-radius: 999px;
    object-fit: cover;
    border: 2px solid var(--color-purple-deep);
  }

  .author-card__initials {
    width: 3.2rem;
    height: 3.2rem;
    border-radius: 999px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.1rem;
    color: #ffffff;
    background: linear-gradient(135deg, var(--color-purple-deep), var(--color-purple-hover));
    letter-spacing: 0.02em;
    flex-shrink: 0;
  }

  .author-card__content {
    flex: 1;
    min-width: 0;
  }

  .author-card__name-row {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    flex-wrap: wrap;
  }

  .author-card__name {
    margin: 0;
    font-size: 1rem;
    font-family: var(--font-display);
    font-weight: 700;
    line-height: 1.2;
    color: var(--color-text-heading);
  }

  .author-card__badge {
    display: inline-flex;
    align-items: center;
    gap: 0.2rem;
    padding: 0.12rem 0.5rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-purple-deep), transparent 88%);
    color: var(--color-purple-deep);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    white-space: nowrap;
  }

  .author-card__role {
    margin: 0.2rem 0 0;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-purple-deep);
    letter-spacing: 0.02em;
  }

  .author-card__bio {
    margin: 0.35rem 0 0;
    font-size: 0.88rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
  }
</style>
