---
import { clusterLabel } from "../utils/clusters";
import { slugifyTag } from "../utils/content";

interface Props {
  href: string;
  title: string;
  description: string;
  date: Date;
  minutesRead: number;
  cluster: string;
  tags: string[];
  featured?: boolean;
}

const {
  href,
  title,
  description,
  date,
  minutesRead,
  cluster,
  tags,
  featured = false
} = Astro.props as Props;

const dateLabel = date.toLocaleDateString("en-IN", {
  year: "numeric",
  month: "short",
  day: "numeric"
});
---
<article class:list={["post-card", featured && "post-card--featured"]} data-cluster={cluster}>
  <p class="post-card__meta">
    <time datetime={date.toISOString()}>{dateLabel}</time>
    <span aria-hidden="true">•</span>
    <span>{minutesRead} min read</span>
    <span aria-hidden="true">•</span>
    <span class="post-card__cluster">{clusterLabel(cluster)}</span>
  </p>

  <h2 class="post-card__title">
    <a href={href}>{title}</a>
  </h2>

  <p class="post-card__description">{description}</p>

  {tags.length > 0 && (
    <div class="post-card__tags" aria-label="Post tags">
      {tags.slice(0, 4).map((tag) => (
        <a href={`/blog/tag/${slugifyTag(tag)}/`} class="post-card__tag">
          {tag}
        </a>
      ))}
    </div>
  )}

  <div class="post-card__reading-bar" aria-hidden="true"></div>

  <a class="post-card__cta" href={href} aria-label={`Read ${title}`}>
    Continue reading
    <span aria-hidden="true">→</span>
  </a>
</article>

<style>
  .post-card {
    --cluster-color: var(--color-purple-deep);
    position: relative;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-left: 4px solid var(--cluster-color);
    border-radius: var(--shape-radius);
    background: linear-gradient(165deg, var(--color-bg) 0%, var(--color-bg-muted) 100%);
    padding: 1.1rem 1.15rem;
    height: 100%;
    display: grid;
    align-content: start;
    transition: border-color 180ms ease, box-shadow 180ms ease, transform 180ms ease;
  }

  .post-card:hover {
    transform: translateY(-2px);
    border-color: var(--color-border-accent);
    box-shadow: 0 10px 24px color-mix(in srgb, var(--color-purple-deep), transparent 90%);
  }

  .post-card--featured {
    min-height: 320px;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    background: linear-gradient(
      to top,
      color-mix(in srgb, var(--color-purple-deep), transparent 15%) 0%,
      color-mix(in srgb, var(--color-lavender-light), transparent 20%) 52%,
      var(--color-bg-warm) 100%
    );
    border-color: color-mix(in srgb, var(--cluster-color), transparent 65%);
    padding: clamp(1.5rem, 3vw, 2.2rem);
  }

  .post-card--featured .post-card__title {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 2.5vw, 2rem);
    line-height: 1.14;
    letter-spacing: -0.02em;
  }

  .post-card--featured .post-card__description {
    -webkit-line-clamp: 3;
    font-size: 1.03rem;
  }

  .post-card__meta {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.38rem;
    color: var(--color-text-secondary);
    font-size: 0.84rem;
  }

  .post-card__cluster {
    color: var(--cluster-color);
    font-weight: 600;
  }

  .post-card__title {
    margin: 0.58rem 0 0.54rem;
    font-size: clamp(1.2rem, 1.5vw, 1.45rem);
    line-height: 1.28;
    color: var(--color-text-heading);
  }

  .post-card__title a {
    text-decoration: none;
  }

  .post-card__description {
    margin: 0;
    color: var(--color-text-primary);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .post-card__tags {
    margin-top: 0.85rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .post-card__tag {
    border: 1px solid var(--color-border);
    border-radius: 999px;
    padding: 0.18rem 0.56rem;
    color: var(--color-text-secondary);
    font-size: 0.76rem;
    text-decoration: none;
  }

  .post-card__reading-bar {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 3px;
    background: color-mix(in srgb, var(--cluster-color), transparent 65%);
    transition: background-color 180ms ease;
  }

  .post-card:hover .post-card__reading-bar {
    background: color-mix(in srgb, var(--cluster-color), transparent 42%);
  }

  .post-card__cta {
    margin-top: 1rem;
    width: fit-content;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    text-decoration: none;
    color: var(--color-purple-deep);
    font-weight: 700;
    font-size: 0.88rem;
  }

  .post-card__cta span {
    transition: transform 180ms ease;
  }

  .post-card:hover .post-card__cta span {
    transform: translateX(3px);
  }

  .post-card[data-cluster="taxation"] {
    --cluster-color: #e07c3e;
  }

  .post-card[data-cluster="accountancy"] {
    --cluster-color: #4a90d9;
  }

  .post-card[data-cluster="business-studies"] {
    --cluster-color: #5da55d;
  }

  .post-card[data-cluster="economics"] {
    --cluster-color: #d4af37;
  }

  .post-card[data-cluster="finance"] {
    --cluster-color: #6b5b95;
  }

  .post-card[data-cluster="corporate-law"] {
    --cluster-color: #c0392b;
  }

  .post-card[data-cluster="tips-tricks"] {
    --cluster-color: #16a085;
  }

  .post-card[data-cluster="shortcuts"] {
    --cluster-color: #f39c12;
  }

  .post-card[data-cluster="mindmaps"] {
    --cluster-color: #8e44ad;
  }

  .post-card[data-cluster="quick-quiz"] {
    --cluster-color: #2980b9;
  }

  @media (max-width: 640px) {
    .post-card__tags {
      gap: 0.35rem;
    }

    .post-card__tag {
      padding: 0.32rem 0.72rem;
      font-size: 0.82rem;
      line-height: 1.2;
    }
  }
</style>
