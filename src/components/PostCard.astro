---
import { clusterLabel } from "../utils/clusters";
import { slugifyTag } from "../utils/content";

interface Props {
  href: string;
  title: string;
  description: string;
  date: Date;
  minutesRead: number;
  cluster: string;
  tags: string[];
  featured?: boolean;
}

const {
  href,
  title,
  description,
  date,
  minutesRead,
  cluster,
  tags,
  featured = false
} = Astro.props as Props;

const dateLabel = date.toLocaleDateString("en-IN", {
  year: "numeric",
  month: "short",
  day: "numeric"
});
---
<article class:list={["post-card", featured && "post-card--featured"]} data-cluster={cluster}>
  <p class="post-card__meta">
    <time datetime={date.toISOString()}>{dateLabel}</time>
    <span aria-hidden="true">•</span>
    <span>{minutesRead} min read</span>
    <span aria-hidden="true">•</span>
    <span class="post-card__cluster">{clusterLabel(cluster)}</span>
  </p>

  <h2 class="post-card__title">
    <a href={href}>{title}</a>
  </h2>

  <p class="post-card__description">{description}</p>

  {tags.length > 0 && (
    <div class="post-card__tags" aria-label="Post tags">
      {tags.slice(0, 4).map((tag) => (
        <a href={`/blog/tag/${slugifyTag(tag)}/`} class="post-card__tag">
          {tag}
        </a>
      ))}
    </div>
  )}

  <a class="post-card__cta" href={href} aria-label={`Read ${title}`}>
    Continue reading
    <span aria-hidden="true">→</span>
  </a>
</article>

<style>
  .post-card {
    border: 1px solid var(--color-border);
    border-radius: var(--shape-radius);
    background: linear-gradient(165deg, var(--color-bg) 0%, var(--color-bg-muted) 100%);
    padding: 1.1rem 1.15rem;
    height: 100%;
    display: grid;
    align-content: start;
    transition: border-color 180ms ease, box-shadow 180ms ease, transform 180ms ease;
  }

  .post-card:hover {
    transform: translateY(-2px);
    border-color: var(--color-border-accent);
    box-shadow: 0 10px 24px color-mix(in srgb, var(--color-purple-deep), transparent 90%);
  }

  .post-card--featured {
    background: linear-gradient(
      135deg,
      color-mix(in srgb, var(--color-cream), transparent 20%),
      color-mix(in srgb, var(--color-lavender-light), transparent 8%)
    );
    border-color: color-mix(in srgb, var(--color-purple-deep), transparent 72%);
    padding: 1.45rem;
  }

  .post-card__meta {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.38rem;
    color: var(--color-text-secondary);
    font-size: 0.84rem;
  }

  .post-card__cluster {
    color: var(--color-purple-deep);
    font-weight: 600;
  }

  .post-card__title {
    margin: 0.58rem 0 0.54rem;
    font-size: clamp(1.2rem, 1.5vw, 1.45rem);
    line-height: 1.28;
    color: var(--color-text-heading);
  }

  .post-card__title a {
    text-decoration: none;
  }

  .post-card__description {
    margin: 0;
    color: var(--color-text-primary);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .post-card__tags {
    margin-top: 0.85rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .post-card__tag {
    border: 1px solid var(--color-border);
    border-radius: 999px;
    padding: 0.18rem 0.56rem;
    color: var(--color-text-secondary);
    font-size: 0.76rem;
    text-decoration: none;
  }

  .post-card__cta {
    margin-top: 1rem;
    width: fit-content;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    text-decoration: none;
    color: var(--color-purple-deep);
    font-weight: 700;
    font-size: 0.88rem;
  }

  .post-card__cta span {
    transition: transform 180ms ease;
  }

  .post-card:hover .post-card__cta span {
    transform: translateX(3px);
  }
</style>
