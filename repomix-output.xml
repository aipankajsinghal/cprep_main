<file path="src/components/InlineQuiz.astro">
---
import type { Quiz } from "../types/global";

interface Props {
  quiz: Quiz;
}

const { quiz } = Astro.props;
const mode = quiz.mode ?? "practice";
const timeLimit = quiz.timeLimit;
const questions = quiz.questions || [];

// Validation
if (!questions || questions.length === 0) {
  throw new Error("InlineQuiz: No questions provided");
}

// Calculate quiz ID for analytics and DOM traversal
const quizId = `quiz-${Math.random().toString(36).slice(2, 9)}`;
---

<div class="inline-quiz" data-quiz-id={quizId} data-mode={mode} data-time-limit={timeLimit}>
  <form class="quiz-form" novalidate>
    <div class="quiz-header">
      {quiz.title && <h2 class="quiz-title">{quiz.title}</h2>}
      <div class="quiz-instructions" role="status" aria-live="polite">
        {mode === "practice" ? (
          <p class="instruction-text">
            💡 Select each answer to get instant feedback and learn as you go.
          </p>
        ) : (
          <p class="instruction-text">
            📝 Choose your answers carefully. You'll see results and explanations after you submit.
          </p>
        )}
      </div>
    </div>

    {timeLimit && (
      <div class="quiz-timer" role="timer" aria-live="polite" aria-label="Time remaining" title="You have this much time to complete the quiz. The timer starts when you select your first answer.">
        <span class="timer-label">⏱ Time left:</span>
        <span class="timer-display" data-timer-display>--:--</span>
      </div>
    )}

    <div class="quiz-content">
      {questions.map((q, idx) => (
        <fieldset class="quiz-question" data-question-index={idx} data-correct-index={q.correctIndex}>
          <legend class="question-text">{q.question}</legend>
          <div class="options-group">
            {q.options.map((option, optIdx) => (
              <div class="option-container">
                <input
                  type="radio"
                  name={`question-${idx}`}
                  id={`q${idx}-opt${optIdx}`}
                  value={optIdx.toString()}
                  class="option-input"
                  data-option-index={optIdx}
                  title="Click to select this answer"
                />
                <label for={`q${idx}-opt${optIdx}`} class="option-label">
                  {option}
                </label>
                <div class="option-feedback" aria-live="polite" aria-atomic="true"></div>
              </div>
            ))}
          </div>
          {q.explanation && (
            <details class="explanation-toggle" data-explanation-for={idx} title={mode === "practice" ? "Click to see why this answer is correct" : "Click to read the explanation"}>
              <summary>
                <span class="explanation-icon">📖</span> Explanation
              </summary>
              <p class="explanation-text">{q.explanation}</p>
            </details>
          )}
        </fieldset>
      ))}
    </div>

    {/* No-JS Fallback: Show all answers */}
    <details class="answers-reveal-no-js" hidden title="View the correct answers without JavaScript">
      <summary>🔑 Answer Key (No JavaScript)</summary>
      <div class="answer-key-content">
        {questions.map((q, idx) => (
          <div class="answer-item">
            <strong>Q{idx + 1}:</strong> {q.question}
            <br />
            <span class="answer-indicator">➜ Answer: {q.options[q.correctIndex]}</span>
            {q.explanation && (
              <>
                <br />
                <em>Why:</em> {q.explanation}
              </>
            )}
          </div>
        ))}
      </div>
    </details>

    <div class="quiz-actions">
      {mode === "exam" ? (
        <button type="button" class="btn-submit" data-action="submit" disabled title="Select all answers first, then click to see your results">
          Submit Answers
        </button>
      ) : (
        <div class="quiz-score" aria-live="polite" aria-atomic="true" title={`Your current score: select answers above to see how you're doing`}>
          Your Score: <span class="score-value">0</span> / <span class="score-total">{questions.length}</span>
        </div>
      )}
    </div>

    <div class="quiz-feedback" aria-live="polite" aria-atomic="true" role="status"></div>
  </form>
</div>

