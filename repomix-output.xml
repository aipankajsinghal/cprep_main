<file path="scripts/generate-ig-briefs.mjs">
import fs from 'fs';
import path from 'path';
import { fileURLToPath } from 'url';

const __dirname = path.dirname(fileURLToPath(import.meta.url));
const outputFile = path.join(__dirname, '../public/data/instagram-briefs.json');

async function generateBriefs() {
  try {
    // Check if required Sanity environment variables are set
    if (!process.env.SANITY_PROJECT_ID || process.env.SANITY_PROJECT_ID.includes('your_project_id')) {
      console.log('⏭️  Skipping Instagram briefs generation: SANITY_PROJECT_ID not configured');
      console.log('   Configure Sanity environment variables in Vercel to enable briefs generation');
      return;
    }

    const briefs = [];

    // Initialize Sanity Client
    const { createClient } = await import('@sanity/client');
    const client = createClient({
      projectId: process.env.SANITY_PROJECT_ID,
      dataset: process.env.SANITY_DATASET || 'production',
      apiVersion: process.env.SANITY_API_VERSION || '2024-01-01',
      useCdn: false,
      token: process.env.SANITY_API_TOKEN,
    });

    const query = `*[_type == "post" && draft != true] {
      "slug": slug.current,
      title,
      description,
      tags,
      publishDate
    }`;

    const posts = await client.fetch(query);

    const now = new Date();

    for (const post of posts) {
      if (!post.slug || !post.title || !post.description) {
        console.warn(`⚠️ Skipped post: Missing required fields (slug/title/description)`);
        continue;
      }

      const publishDate = post.publishDate ? new Date(post.publishDate) : null;

      // Determine publish status
      let status = 'published';
      let daysUntilPublish = null;

      if (publishDate && publishDate > now) {
        status = 'scheduled';
        daysUntilPublish = Math.ceil(
          (publishDate - now) / (1000 * 60 * 60 * 24)
        );
      }

      // Create Instagram brief (max 300 chars for caption + hashtags)
      const brief = {
        slug: post.slug,
        title: post.title,
        description: post.description,
        url: `https://www.championsprep.in/blog/${post.slug}/`,
        hashTags: post.tags && post.tags.length > 0
          ? post.tags.map(t => `#${t.toLowerCase().replace(/\s+/g, '')}`).join(' ')
          : '#ChampionsPrep #Commerce #Exam',
        status,
        publishDate: publishDate?.toISOString().split('T')[0],
        daysUntilPublish,
        // Instagram caption template (ready to copy-paste)
        caption: [
          post.description,
          '',
          `Read full article: https://www.championsprep.in/blog/${post.slug}/`,
          '',
          post.tags && post.tags.length > 0
            ? post.tags.map(t => `#${t.toLowerCase().replace(/\s+/g, '')}`).join(' ')
            : '#ChampionsPrep #Commerce #Exam'
        ].join('\n')
      };

      briefs.push(brief);
    }

    // Sort by publish date (scheduled first, then published by date descending)
    briefs.sort((a, b) => {
      if (a.status === 'scheduled' && b.status !== 'scheduled') return -1;
      if (a.status !== 'scheduled' && b.status === 'scheduled') return 1;
      if (a.publishDate && b.publishDate) {
        return new Date(b.publishDate) - new Date(a.publishDate);
      }
      return 0;
    });

    // Ensure output directory exists
    const outputDir = path.dirname(outputFile);
    if (!fs.existsSync(outputDir)) {
      try {
        fs.mkdirSync(outputDir, { recursive: true });
      } catch (error) {
        console.error(`❌ Failed to create output directory: ${error.message}`);
        process.exit(1);
      }
    }

    // Write to JSON file
    try {
      fs.writeFileSync(outputFile, JSON.stringify(briefs, null, 2), 'utf-8');
    } catch (error) {
      console.error(`❌ Failed to write briefs file: ${error.message}`);
      process.exit(1);
    }

    console.log(`✓ Generated ${briefs.length} Instagram briefs`);
    console.log(`✓ Saved to ${outputFile}`);

    // Log scheduled posts
    const scheduled = briefs.filter(b => b.status === 'scheduled');
    if (scheduled.length > 0) {
      console.log('\n📅 Scheduled Posts:');
      scheduled.forEach(b => {
        console.log(`  • ${b.title} (in ${b.daysUntilPublish} days)`);
      });
    }
  } catch (error) {
    console.error(`❌ Unexpected error: ${error.message}`);
    process.exit(1);
  }
}

generateBriefs().catch(err => {
  console.error('Error generating briefs:', err);
  process.exit(1);
});
</file>

<file path="src/components/InlineAssistant.astro">
---
interface Props {
  type?: "simplify" | "exam-summary" | "example";
  context?: "section" | "article";
  endpoint?: string;
}

const { type = "simplify", context = "section", endpoint = "/api/inline-ai" } = Astro.props as Props;
---
<aside
  class="inline-assistant"
  data-inline-assistant
  data-default-action={type}
  data-context={context}
  data-endpoint={endpoint}
  aria-label="Inline study assistant"
>
  <p class="inline-assistant__label">AI Study Assist</p>
  <div class="inline-assistant__actions">
    <button type="button" data-assistant-action="simplify" aria-expanded="false">Simplify explanation</button>
    <button type="button" data-assistant-action="exam-summary" aria-expanded="false">Exam-focused summary</button>
    <button type="button" data-assistant-action="example" aria-expanded="false">Show example</button>
  </div>
  <div class="inline-assistant__output" data-assistant-output hidden></div>
</aside>

<script>
  const blocks = Array.from(document.querySelectorAll("[data-inline-assistant]"));
  const normalizeTopic = (value: string) =>
    value.replace(/[✓#]/g, " ").replace(/\s+/g, " ").trim();

  const extractContext = (root: Element, mode: string) => {
    if (mode === "article") {
      const body = document.querySelector(".post-body");
      const articleText = body?.textContent?.replace(/\s+/g, " ").trim().slice(0, 1200) ?? "";
      return {
        topic: "Article",
        contextText: articleText
      };
    }

    const section = root.closest("[data-learning-section]");
    if (section instanceof HTMLElement) {
      const heading = section.querySelector("h2,h3");
      const shadow = section.cloneNode(true);
      if (shadow instanceof HTMLElement) {
        for (const assistant of shadow.querySelectorAll("[data-inline-assistant]")) {
          assistant.remove();
        }
      }
      return {
        topic: normalizeTopic(heading?.textContent ?? "") || "Section",
        contextText:
          (shadow instanceof HTMLElement ? shadow.innerText : section.innerText)
            .replace(/\s+/g, " ")
            .trim()
            .slice(0, 1200)
      };
    }

    // Fallback path when section wrappers are absent.
    const fallbackHeading =
      (root.previousElementSibling instanceof HTMLHeadingElement ? root.previousElementSibling.textContent : "") || "";
    const fallbackText =
      root.parentElement?.textContent?.replace(/\s+/g, " ").trim().slice(0, 1200) ?? "";
    return {
      topic: normalizeTopic(fallbackHeading) || "Section",
      contextText: fallbackText
    };
  };

  for (const block of blocks) {
    const buttons = Array.from(block.querySelectorAll("[data-assistant-action]"));
    const output = block.querySelector("[data-assistant-output]");
    if (!(output instanceof HTMLElement) || !buttons.length) continue;

    let activeAction = block.getAttribute("data-default-action") ?? "";
    let loaded: Promise<any> | null = null;
    let activeRequestId = 0;

    const closeAll = () => {
      for (const button of buttons) {
        if (button instanceof HTMLButtonElement) {
          button.setAttribute("aria-expanded", "false");
        }
      }
      output.hidden = true;
      output.textContent = "";
      activeAction = "";
    };

    block.addEventListener("click", async (event) => {
      const target = event.target;
      if (!(target instanceof HTMLElement)) return;
      const button = target.closest("[data-assistant-action]");
      if (!(button instanceof HTMLButtonElement)) return;

      const action = button.getAttribute("data-assistant-action");
      if (!action) return;

      if (activeAction === action && !output.hidden) {
        closeAll();
        return;
      }

      for (const item of buttons) {
        if (item instanceof HTMLButtonElement) {
          item.setAttribute("aria-expanded", item === button ? "true" : "false");
        }
      }

      output.hidden = false;
      output.textContent = "Loading focused help...";

      try {
        if (!loaded) {
          loaded = import("../utils/inlineAssistantClient");
        }
        const module = await loaded;
        const context = block.getAttribute("data-context") ?? "section";
        const endpoint = block.getAttribute("data-endpoint") ?? "";
        const { topic, contextText } = extractContext(block, context);
        const postSlug = window.__cpGaContext?.post_slug ?? "";
        const cacheKey = `${postSlug}::${topic}::${action}`;
        const requestId = ++activeRequestId;

        // 1) Runtime cache first.
        const cached = module.getCachedRuntimeResponse(cacheKey);
        if (cached) {
          output.textContent = cached;
          activeAction = action;
          return;
        }

        // 2) Static response next (instant first paint for the hint).
        const staticText = await module.getStaticResponse(action, cacheKey);
        if (requestId !== activeRequestId) return;
        output.textContent = staticText;
        activeAction = action;

        // 3) Runtime enhancement last (optional progressive upgrade).
        module
          .requestRuntimeHint({
            endpoint: endpoint || undefined,
            action,
            topic,
            contextText,
            cacheKey
          })
          .then((runtimeText: string | undefined) => {
            if (requestId !== activeRequestId) return;
            if (activeAction !== action) return;
            if (!runtimeText || runtimeText === output.textContent) return;
            output.classList.add("inline-assistant__output--refresh");
            output.textContent = runtimeText;
            requestAnimationFrame(() => {
              output.classList.remove("inline-assistant__output--refresh");
            });
          })
          .catch(() => {});
      } catch {
        output.textContent = "Unable to fetch assistance right now. Try again in a moment.";
      }
    });
  }
</script>

