---
import '../styles/global.css';
import '../styles/tokens.css';
import '../styles/typography.css';
import '../styles/print.css';
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import InlineQuiz from "../components/InlineQuiz.astro";
import Toast from "../components/Toast.astro";
import SpeedInsights from '@vercel/speed-insights/astro';
import Analytics from '@vercel/analytics/astro';
import { slugifyTag } from "../utils/content";
import { getClient } from "../lib/sanity";
import { ALL_POSTS_QUERY } from "../lib/queries";

type JsonLdValue = Record<string, unknown>;

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  ogType?: string;
  noindex?: boolean;
  pagefindStyles?: boolean;
  jsonLd?: JsonLdValue | JsonLdValue[];
  gaContext?: Record<string, string>;
  author?: string;
  publishedDate?: string;
  updatedDate?: string;
  articleTags?: string[];
  articleSection?: string;
}

const {
  title = "ChampionsPrep Blog",
  description = "High-performance editorial content for exam preparation.",
  canonical,
  ogImage,
  ogType = "website",
  noindex = false,
  pagefindStyles = false,
  jsonLd = [],
  gaContext = {},
  author,
  publishedDate,
  updatedDate,
  articleTags,
  articleSection,
} = Astro.props as Props;

const pageTitle = title.includes("ChampionsPrep") ? title : `${title} | ChampionsPrep Blog`;
const normalizeCanonical = (value: string): string => {
  const parsed = new URL(value);
  if (!/\.[a-z0-9]+$/i.test(parsed.pathname) && !parsed.pathname.endsWith("/")) {
    parsed.pathname = `${parsed.pathname}/`;
  }
  return parsed.toString();
};
const canonicalUrl = normalizeCanonical(canonical ?? new URL(Astro.url.pathname, Astro.site ?? Astro.url).toString());
const ogImageUrl = ogImage ? new URL(ogImage, Astro.site ?? Astro.url).toString() : undefined;
const jsonLdBlocks = Array.isArray(jsonLd) ? jsonLd : [jsonLd];
const gaMeasurementId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID;
const isPreview = Astro.cookies.has('sanity-preview');
const client = getClient(isPreview);
const navTags = await client.fetch(ALL_POSTS_QUERY).then((posts: any[]) => {
  const counter = new Map<string, { slug: string; label: string; count: number }>();
  for (const post of posts) {
    for (const tag of post.tags ?? []) {
      const slug = slugifyTag(tag);
      const existing = counter.get(slug);
      if (existing) {
        existing.count += 1;
      } else {
        counter.set(slug, { slug, label: tag, count: 1 });
      }
    }
  }
  return Array.from(counter.values())
    .sort((a, b) => b.count - a.count || a.label.localeCompare(b.label))
    .slice(0, 12)
    .map(({ slug, label }) => ({ slug, label }));
});
// Quiz placement helpers
const entryData = (Astro.props as any).entry?.data;
const quizData = entryData?.quiz ? (entryData.quiz as import("../types/global").Quiz | undefined) : undefined;
const hasInlineQuiz = Astro.slots?.has && Astro.slots.has("quiz");
const shouldRenderQuiz = !hasInlineQuiz && quizData && quizData.questions && quizData.questions.length > 0;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#6b5b95" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
    {ogImageUrl && <meta property="og:image:width" content="1200" />}
    {ogImageUrl && <meta property="og:image:height" content="630" />}
    {ogImageUrl && <meta property="og:image:type" content="image/png" />}
    <meta property="og:site_name" content="ChampionsPrep Blog" />
    {ogType === "article" && author && <meta property="article:author" content={author} />}
    {ogType === "article" && publishedDate && <meta property="article:published_time" content={publishedDate} />}
    {ogType === "article" && updatedDate && <meta property="article:modified_time" content={updatedDate} />}
    {ogType === "article" && articleSection && <meta property="article:section" content={articleSection} />}
    {ogType === "article" && articleTags && articleTags.map((tag) => <meta property="article:tag" content={tag} />)}
    {ogType === "article" && author && <meta name="author" content={author} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@championsprep" />
    {ogType === "article" && <meta name="twitter:creator" content="@championsprep" />}
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    {ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="CPrep Blog" />
    <Analytics />
    <script is:inline>
      (() => {
        const key = "theme";
        let mode = "light";
        try {
          const saved = localStorage.getItem(key);
          if (saved === "light" || saved === "dark") {
            mode = saved;
          } else if (window.matchMedia("(prefers-color-scheme: dark)").matches) {
            mode = "dark";
          }
        } catch {}
        if (mode === "dark") {
          document.documentElement.classList.add("dark");
        }
      })();
    </script>
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="en-IN" href={canonicalUrl} />
    <link rel="alternate" hreflang="en" href={canonicalUrl} />
    <link rel="alternate" hreflang="x-default" href={canonicalUrl} />
    <link rel="alternate" type="application/rss+xml" title="ChampionsPrep Blog" href="/rss.xml" />
    <link rel="preconnect" href="https://cdn.sanity.io" />
    <link rel="dns-prefetch" href="https://cdn.sanity.io" />
    <link rel="manifest" href="/manifest.webmanifest" />
    {pagefindStyles && <link rel="stylesheet" href="/pagefind/pagefind-ui.css" />}
    <link
      rel="preload"
      href="/fonts/inter-latin-400-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <link
      rel="preload"
      href="/fonts/inter-latin-600-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <link
      rel="preload"
      href="/fonts/source-serif-4-latin-600-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <link
      rel="preload"
      href="/fonts/source-serif-4-latin-700-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <link rel="stylesheet" href="/vendor/shareon/shareon.min.css" />
    <script defer is:inline src="/vendor/shareon/shareon.iife.js"></script>
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {jsonLdBlocks.map((block) => (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(block)} />
    ))}
    {gaMeasurementId && (
      <>
        <script async is:inline src={`https://www.googletagmanager.com/gtag/js?id=${gaMeasurementId}`}></script>
        <script is:inline define:vars={{ gaMeasurementId }}>
          window.dataLayer = window.dataLayer || [];
          function gtag() {
            window.dataLayer.push(arguments);
          }
          window.gtag = window.gtag || gtag;
          window.gtag("js", new Date());
          window.gtag("config", gaMeasurementId);
        </script>
      </>
    )}
    <script is:inline define:vars={{ gaContext }}>
      window.__cpGaContext = gaContext;
      window.cpTrack = function (eventName, eventParams) {
        if (typeof window.gtag !== "function") return;
        const merged = Object.assign({}, window.__cpGaContext || {}, eventParams || {});
        window.gtag("event", eventName, merged);
      };
    </script>
    <script is:inline>
      window.addEventListener("DOMContentLoaded", () => {
        if (window.Shareon && typeof window.Shareon.init === "function") {
          window.Shareon.init();
        }
      });
    </script>
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <SiteHeader tags={navTags} />
    <main id="main-content" class="page-shell">
      <article class="editorial" data-pagefind-body>
        <slot />
        <slot name="quiz" />

        {shouldRenderQuiz && (
          <section class="post-quiz-section">
            <InlineQuiz quiz={quizData as import("../types/global").Quiz} />
          </section>
        )}
      </article>
    </main>
    <SiteFooter />
    <Toast />
    <SpeedInsights />
    <button class="scroll-top" type="button" aria-label="Scroll to top" data-scroll-top hidden>
      ↑
    </button>
    <script is:inline>
      (() => {
        const key = "theme";
        const buttons = Array.from(document.querySelectorAll("[data-theme-toggle]")).filter((button) =>
          button instanceof HTMLButtonElement
        );
        if (!buttons.length) return;

        const syncLabel = () => {
          const dark = document.documentElement.classList.contains("dark");
          for (const button of buttons) {
            if (!(button instanceof HTMLButtonElement)) continue;
            button.textContent = dark ? "Light Mode" : "Dark Mode";
          }
        };

        syncLabel();
        for (const button of buttons) {
          if (!(button instanceof HTMLButtonElement)) continue;
          button.addEventListener("click", () => {
            const isDark = document.documentElement.classList.toggle("dark");
            try {
              localStorage.setItem(key, isDark ? "dark" : "light");
            } catch {}
            syncLabel();
          });
        }
      })();
    </script>
    <script is:inline>
      (() => {
        const button = document.querySelector("[data-scroll-top]");
        if (!(button instanceof HTMLButtonElement)) return;

        const onScroll = () => {
          button.hidden = window.scrollY < 420;
        };

        onScroll();
        window.addEventListener("scroll", onScroll, { passive: true });
        button.addEventListener("click", () => {
          window.scrollTo({ top: 0, behavior: "smooth" });
        });
      })();
    </script>
    <script is:inline>
      (() => {
        if (!("serviceWorker" in navigator)) return;
        window.addEventListener("load", () => {
          navigator.serviceWorker.register("/sw.js", { scope: "/" }).catch(() => {});
        });
      })();
    </script>
  </body>
</html>
</file>

<file path="src/pages/blog/index.astro">
---
import BlogLayout from '../../layouts/BlogLayout.astro';
import SearchWidget from "../../components/SearchWidget.astro";
import PostCard from "../../components/PostCard.astro";
import { sanityClient } from "../../lib/sanity";
import { ALL_POSTS_QUERY } from "../../lib/queries";
import { calculateMinutesRead } from "../../lib/markdown";
import { clusterLabel } from "../../utils/clusters";

export const prerender = false;

const now = new Date();
const rawPosts = sanityClient ? await sanityClient.fetch(ALL_POSTS_QUERY) : [];

const posts = rawPosts
  .filter((post: any) => {
    if (post.publishDate && new Date(post.publishDate) > now) return false;
    return true;
  })
  .map((post: any) => ({
    ...post,
    date: new Date(post.date),
    publishDate: post.publishDate ? new Date(post.publishDate) : undefined,
    updatedDate: post.updatedDate ? new Date(post.updatedDate) : undefined,
    minutesRead: post.minutesRead ?? calculateMinutesRead(post.body ?? ''),
  }));

const featuredPost = posts[0];
const gridPosts = featuredPost ? posts.slice(1) : posts;
const availableClusters = Array.from(new Set(posts.map((post: any) => post.cluster))).sort((a: any, b: any) =>
  clusterLabel(a).localeCompare(clusterLabel(b))
);

const pageTitle = "ChampionsPrep Blog";
const pageDescription =
  "Editorial explainers, revision strategies, and exam-focused insights for Class 11-12 Commerce students.";
const canonical = new URL("/blog/", Astro.site ?? Astro.url).toString();
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Blog",
    name: "ChampionsPrep Blog",
    description: pageDescription,
    url: canonical
  },
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    name: "ChampionsPrep",
    url: "https://www.championsprep.in",
    logo: "https://www.championsprep.in/icons/icon-512.svg",
    sameAs: [
      "https://www.instagram.com/champions.prep/",
      "https://x.com/championsprep"
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "ChampionsPrep Blog",
    url: canonical,
    potentialAction: {
      "@type": "SearchAction",
      target: `${canonical}?search={search_term_string}`,
      "query-input": "required name=search_term_string"
    }
  }
];

const spotlightPosts = gridPosts.slice(0, 3);
---
<BlogLayout title={pageTitle} description={pageDescription} canonical={canonical} jsonLd={jsonLd} pagefindStyles={true}>
  <header class="blog-index__hero">
    <div class="blog-index__masthead-rule" aria-hidden="true"></div>
    <p class="blog-index__eyebrow">
      <span>Insights</span>
      <span aria-hidden="true">·</span>
      <span>{posts.length} articles · {availableClusters.length} topics</span>
    </p>
    <h1 class="blog-index__headline">ChampionsPrep<br class="blog-index__br" />Commerce Blog</h1>
    <p class="blog-index__dek">{pageDescription}</p>
    <div class="blog-index__masthead-rule blog-index__masthead-rule--bottom" aria-hidden="true"></div>
  </header>

  <SearchWidget />

  {spotlightPosts.length > 0 && (
    <section class="blog-index__spotlight" aria-labelledby="spotlight-title">
      <h2 id="spotlight-title">Start with these reads</h2>
      <div class="blog-index__spotlight-grid">
        {spotlightPosts.map((post: any) => (
          <a href={`/blog/${post.slug}/`} class="blog-index__spotlight-link">
            <span class="blog-index__spotlight-cluster">{clusterLabel(post.cluster)}</span>
            <span class="blog-index__spotlight-title">{post.title}</span>
            <span class="blog-index__spotlight-meta">{post.minutesRead} min read</span>
          </a>
        ))}
      </div>
    </section>
  )}

  {featuredPost && (
    <section class="blog-index__featured" aria-labelledby="featured-post-title">
      <div class="blog-index__section-heading">
        <p class="blog-index__eyebrow">Latest Article</p>
        <h2 id="featured-post-title">Featured Post</h2>
      </div>
      <PostCard
        href={`/blog/${featuredPost.slug}/`}
        title={featuredPost.title}
        description={featuredPost.description}
        date={featuredPost.date}
        minutesRead={featuredPost.minutesRead}
        cluster={featuredPost.cluster}
        tags={featuredPost.tags}
        featured={true}
      />
    </section>
  )}

  {availableClusters.length > 0 && (
    <section class="blog-index__filters" aria-label="Filter posts by cluster">
      <div class="blog-index__section-heading">
        <p class="blog-index__eyebrow">Browse by Topic</p>
        <h2>Clusters</h2>
      </div>
      <div class="blog-index__filter-row">
        <button type="button" data-cluster-filter="all" class="is-active">All</button>
        {availableClusters.map((cluster: any) => (
          <button type="button" data-cluster-filter={cluster}>
            {clusterLabel(cluster)}
          </button>
        ))}
      </div>
    </section>
  )}

  <section class="blog-index__grid" data-cluster-grid>
    {gridPosts.map((post: any) => (
      <div data-cluster-card={post.cluster}>
        <PostCard
          href={`/blog/${post.slug}/`}
          title={post.title}
          description={post.description}
          date={post.date}
          minutesRead={post.minutesRead}
          cluster={post.cluster}
          tags={post.tags}
          featured={false}
        />
      </div>
    ))}
  </section>

  {posts.length === 0 && <p class="blog-index__empty">No posts published yet.</p>}
</BlogLayout>

<script>
  const filterButtons = Array.from(document.querySelectorAll("[data-cluster-filter]"));
  const cards = Array.from(document.querySelectorAll("[data-cluster-card]"));

  if (filterButtons.length > 0 && cards.length > 0) {
    const markFirstVisible = () => {
      let marked = false;
      for (const card of cards) {
        if (!(card instanceof HTMLElement)) continue;
        card.classList.remove("is-featured-slot");
        if (card.hidden || marked) continue;
        card.classList.add("is-featured-slot");
        marked = true;
      }
    };

    const setFilter = (cluster: string) => {
      for (const button of filterButtons) {
        if (!(button instanceof HTMLButtonElement)) continue;
        button.classList.toggle("is-active", button.dataset.clusterFilter === cluster);
      }

      for (const card of cards) {
        if (!(card instanceof HTMLElement)) continue;
        const cardCluster = card.dataset.clusterCard ?? "";
        card.hidden = cluster !== "all" && cardCluster !== cluster;
      }

      markFirstVisible();
    };

    for (const button of filterButtons) {
      if (!(button instanceof HTMLButtonElement)) continue;
      button.addEventListener("click", () => {
        const cluster = button.dataset.clusterFilter ?? "all";
        setFilter(cluster);
      });
    }

    setFilter("all");
  }
</script>

<style>
  .blog-index__hero {
    padding: clamp(1.5rem, 4vw, 2.8rem) 0;
    text-align: center;
    border-bottom: 0;
  }

  .blog-index__masthead-rule {
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent 0%,
      var(--color-border) 20%,
      var(--color-purple-deep) 50%,
      var(--color-border) 80%,
      transparent 100%
    );
    margin-bottom: 1.4rem;
  }

  .blog-index__masthead-rule--bottom {
    margin-top: 1.8rem;
    margin-bottom: 0;
  }

  .blog-index__headline {
    margin: 0.55rem 0 0;
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 7vw, 4.2rem);
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--color-text-heading);
  }

  .blog-index__br {
    display: none;
  }

  .blog-index__dek {
    margin: 0.9rem auto 0;
    color: var(--color-text-secondary);
    max-width: 58ch;
    font-size: clamp(0.95rem, 1.2vw, 1.08rem);
    line-height: 1.7;
  }

  .blog-index__eyebrow {
    margin: 0 0 0.35rem;
    color: var(--color-purple-deep);
    font-size: 0.76rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.09em;
  }

  .blog-index__spotlight,
  .blog-index__featured,
  .blog-index__filters {
    margin-top: var(--space-xl);
  }

  .blog-index__section-heading h2,
  .blog-index__spotlight h2 {
    margin: 0;
    font-size: 1.12rem;
  }

  .blog-index__spotlight-grid {
    margin-top: 0.75rem;
    display: grid;
    gap: 0.65rem;
  }

  .blog-index__spotlight-link {
    display: grid;
    gap: 0.12rem;
    padding: 0.7rem 0.8rem;
    border: 1px solid var(--color-border);
    border-radius: 10px;
    text-decoration: none;
    background: var(--color-bg);
  }

  .blog-index__spotlight-cluster {
    font-size: 0.74rem;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--color-purple-deep);
    font-weight: 700;
  }

  .blog-index__spotlight-title {
    color: var(--color-text-heading);
    font-weight: 700;
    line-height: 1.35;
  }

  .blog-index__spotlight-meta {
    color: var(--color-text-secondary);
    font-size: 0.82rem;
  }

  .blog-index__filter-row {
    margin-top: 0.65rem;
    display: flex;
    gap: 0.45rem;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    scroll-snap-type: x mandatory;
    padding-bottom: 0.2rem;
  }

  .blog-index__filter-row::-webkit-scrollbar {
    display: none;
  }

  .blog-index__filter-row button {
    flex: 0 0 auto;
    scroll-snap-align: start;
    white-space: nowrap;
    appearance: none;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: var(--color-bg);
    color: var(--color-text-primary);
    padding: 0.24rem 0.7rem;
    font: inherit;
    font-size: 0.84rem;
    cursor: pointer;
  }

  .blog-index__filter-row button.is-active {
    border-color: var(--color-border-accent);
    background: color-mix(in srgb, var(--color-lavender-light), transparent 35%);
    color: var(--color-purple-deep);
  }

  .blog-index__grid {
    margin-top: var(--space-lg);
    display: grid;
    gap: 1rem;
    align-items: stretch;
    grid-template-columns: 1fr;
  }

  .blog-index__empty {
    margin-top: var(--space-xl);
    text-align: center;
    color: var(--color-text-secondary);
  }

  .blog-index__empty::before {
    content: "◇";
    display: block;
    margin-bottom: var(--space-sm);
    font-size: 2.2rem;
    color: var(--color-purple-deep);
    opacity: 0.35;
  }

  @media (min-width: 640px) {
    .blog-index__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .blog-index__grid > .is-featured-slot {
      grid-column: 1 / -1;
    }
  }

  @media (min-width: 820px) {
    .blog-index__hero-meta {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .blog-index__spotlight-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (min-width: 960px) {
    .blog-index__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .blog-index__grid > .is-featured-slot {
      grid-column: 1 / 3;
      grid-row: 1 / 3;
    }
  }
</style>
</file>

<file path="src/pages/blog/[...slug].astro">
---
import BlogLayout from "../../layouts/BlogLayout.astro";
import ExamTip from "../../components/ExamTip.astro";
import RelatedPosts from "../../components/RelatedPosts.astro";
import AuthorCard from "../../components/AuthorCard.astro";
import TableOfContents from "../../components/TableOfContents.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import PrevNextNav from "../../components/PrevNextNav.astro";
import ReadingProgress from "../../components/ReadingProgress.astro";
import ShareButtons from "../../components/ShareButtons.astro";
import MicroFeedback from "../../components/MicroFeedback.astro";
import SmartCTA from "../../components/SmartCTA.astro";
import { getClient } from "../../lib/sanity";
import {
  ALL_POSTS_QUERY,
  ALL_SLUGS_QUERY,
  POST_BY_SLUG_QUERY,
} from "../../lib/queries";
import type { Post } from "../../../studio/sanity.types";
import { markdownToHtml, calculateMinutesRead } from "../../lib/markdown";
import { slugifyTag } from "../../utils/content";
import { clusterLabel } from "../../utils/clusters";

export const prerender = false;

export async function getStaticPaths() {
  try {
    const client = getClient();
    const slugs = await client.fetch(ALL_SLUGS_QUERY);
    return slugs.map((item: { slug: string }) => ({
      params: { slug: item.slug },
    }));
  } catch {
    return [];
  }
}

const { slug } = Astro.params as { slug: string };
const isPreview = Astro.cookies.has("sanity-preview");
try {
  const client = getClient(isPreview);
  const post = await client.fetch<Post>(POST_BY_SLUG_QUERY, { slug });

  if (!post) {
    return Astro.redirect("/blog/");
  }
} catch (e) {
  return Astro.redirect("/blog/");
}

const { html: bodyHtml, headings } = await markdownToHtml(post.body ?? "");
const tocHeadings = headings.filter(
  (item) => item.depth === 2 || item.depth === 3,
);

const postDate = new Date(post.date ?? "");
const updatedDate = post.updatedDate ? new Date(post.updatedDate) : postDate;
const minutesRead = post.minutesRead ?? calculateMinutesRead(post.body ?? "");

const canonical = new URL(`/blog/${slug}/`, Astro.site ?? Astro.url).toString();
const ogImagePath = post.ogImage ?? `/blog/og/${slug}.png`;
const ogImageUrl = new URL(ogImagePath, Astro.site ?? Astro.url).toString();

const publishedLabel = postDate.toLocaleDateString("en-IN", {
  year: "numeric",
  month: "short",
  day: "numeric",
});
const updatedLabel = updatedDate.toLocaleDateString("en-IN", {
  year: "numeric",
  month: "short",
  day: "numeric",
});

// Related / prev-next navigation from full post list
const now = new Date();
const allPosts = (await client.fetch<Post[]>(ALL_POSTS_QUERY))
  .filter((p: any) => !p.publishDate || new Date(p.publishDate) <= now)
  .map((p: any) => ({ ...p, date: new Date(p.date ?? "") }))
  .sort((a: any, b: any) => b.date.getTime() - a.date.getTime());

const clusterPosts = allPosts.filter(
  (p: any) => p.cluster === (post.cluster ?? ""),
);
const currentIndex = clusterPosts.findIndex((p: any) => p.slug === slug);
const previousPost =
  currentIndex > 0 ? clusterPosts[currentIndex - 1] : undefined;
const nextPost =
  currentIndex >= 0 && currentIndex < clusterPosts.length - 1
    ? clusterPosts[currentIndex + 1]
    : undefined;
const clusterPostsAscending = [...clusterPosts].sort((a: any, b: any) => {
  const byDate = a.date.getTime() - b.date.getTime();
  return byDate !== 0 ? byDate : a.slug.localeCompare(b.slug);
});

// JSON-LD
const blogPostingJsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.title,
  description: post.description,
  datePublished: postDate.toISOString(),
  dateModified: updatedDate.toISOString(),
  image: ogImageUrl,
  author: { "@type": "Person", name: post.author },
  mainEntityOfPage: canonical,
  url: canonical,
};
const learningResourceJsonLd = {
  "@context": "https://schema.org",
  "@type": "LearningResource",
  learningResourceType: "Lesson",
  educationalLevel: "Class 11-12",
  teaches: post.cluster,
  name: post.title,
  description: post.description,
  url: canonical,
};
const learningPathJsonLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: `${post.cluster} Learning Path`,
  itemListOrder: "https://schema.org/ItemListOrderAscending",
  itemListElement: clusterPostsAscending.map((p: any, index: number) => ({
    "@type": "ListItem",
    position: index + 1,
    name: p.title,
    url: new URL(`/blog/${p.slug}/`, Astro.site ?? Astro.url).toString(),
  })),
};
const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Blog",
      item: new URL("/blog/", Astro.site ?? Astro.url).toString(),
    },
    { "@type": "ListItem", position: 2, name: post.title, item: canonical },
  ],
};
const faqItems = post.faqItems ?? [];
const faqJsonLd =
  faqItems.length > 0
    ? {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        mainEntity: faqItems.map((item: any) => ({
          "@type": "Question",
          name: item.q,
          acceptedAnswer: { "@type": "Answer", text: item.a },
        })),
      }
    : undefined;

const baseJsonLd = [
  blogPostingJsonLd,
  learningResourceJsonLd,
  breadcrumbJsonLd,
  learningPathJsonLd,
];
const jsonLd = faqJsonLd ? [...baseJsonLd, faqJsonLd] : baseJsonLd;
---

<BlogLayout
  title={post.title ?? "ChampionsPrep"}
  description={post.description ?? ""}
  canonical={canonical}
  ogImage={ogImagePath}
  ogType="article"
  jsonLd={jsonLd}
  gaContext={{ post_slug: slug, cluster: post.cluster ?? "" }}
  author={post.author ?? "ChampionsPrep"}
  publishedDate={postDate.toISOString()}
  updatedDate={updatedDate.toISOString()}
  articleTags={(post.tags as string[]) ?? []}
  articleSection={post.cluster ?? ""}
>
  <ReadingProgress />
  <Breadcrumbs title={post.title} />
  <section class="post-shell">
    <div class="post-main">
      <header class="post-head" data-cluster={post.cluster}>
        <div class="post-head__cluster-rule" aria-hidden="true"></div>
        <p class="post-head__eyebrow">{clusterLabel(post.cluster)}</p>
        <h1 class="post-head__title">{post.title}</h1>
        <p class="post-head__dek">{post.description}</p>
        <p class="post-head__byline" aria-label="Article metadata">
          <span class="post-head__author">{post.author}</span>
          <span class="post-head__sep" aria-hidden="true">·</span>
          <time datetime={postDate.toISOString()}>{publishedLabel}</time>
          <span class="post-head__sep" aria-hidden="true">·</span>
          <span>{minutesRead} min read</span>
        </p>
        {
          (post.tags ?? []).length > 0 && (
            <div class="post-head__tags" aria-label="Post tags">
              {(post.tags ?? []).map((tag: string) => (
                <a href={`/blog/tag/${slugifyTag(tag)}/`}>{tag}</a>
              ))}
            </div>
          )
        }
      </header>

      <ExamTip title="Quick Revision Tip">
        <p>
          Summarize each section in one sentence before moving to the next
          chapter.
        </p>
      </ExamTip>

      <div class="post-body" set:html={bodyHtml} />

      <PrevNextNav
        previous={previousPost
          ? { href: `/blog/${previousPost.slug}/`, title: previousPost.title }
          : undefined}
        next={nextPost
          ? { href: `/blog/${nextPost.slug}/`, title: nextPost.title }
          : undefined}
      />
      <ShareButtons
        url={canonical}
        title={post.title}
        postSlug={slug}
        cluster={post.cluster}
        instagramId="champions.prep"
      />
      <MicroFeedback postSlug={slug} cluster={post.cluster} />
      <RelatedPosts
        currentSlug={slug}
        cluster={post.cluster}
        tags={post.tags}
      />
      <SmartCTA postSlug={slug} cluster={post.cluster} />
      <AuthorCard name={post.author} />
    </div>

    <aside class="post-toc">
      <div class="post-toc__panel">
        <TableOfContents headings={tocHeadings} />
      </div>
    </aside>
  </section>
</BlogLayout>

<script>
  const headings = Array.from(
    document.querySelectorAll(".post-body h2[id], .post-body h3[id]"),
  );
  for (const heading of headings) {
    if (heading.querySelector(".heading-anchor")) continue;
    const id = heading.getAttribute("id");
    if (!id) continue;
    const anchor = document.createElement("a");
    anchor.className = "heading-anchor";
    anchor.href = `#${id}`;
    anchor.setAttribute(
      "aria-label",
      `Link to ${heading.textContent ?? "section"}`,
    );
    anchor.textContent = "#";
    heading.append(anchor);
  }
</script>

