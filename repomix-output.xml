  <meta charset="utf-8" />
  <title>ChampionsPrep Blog Admin</title>
  <script src="https://unpkg.com/decap-cms@3/dist/decap-cms.js"></script>
</head>
<body></body>
</html>
```

**`public/admin/config.yml`**
```yaml
