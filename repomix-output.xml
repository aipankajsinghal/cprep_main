---
---
<div class="reading-progress" aria-hidden="true">
  <div class="reading-progress__bar" id="reading-progress-bar"></div>
</div>

<script>
  const bar = document.getElementById("reading-progress-bar");
  const article = document.querySelector(".post-main");

  if (bar && article) {
    const updateProgress = () => {
      const rect = article.getBoundingClientRect();
      const total = article.scrollHeight - window.innerHeight;
      if (total <= 0) {
        bar.style.transform = "scaleX(0)";
        return;
      }
      const current = Math.min(Math.max(window.scrollY - (window.scrollY + rect.top), 0), total);
      const ratio = current / total;
      bar.style.transform = `scaleX(${ratio})`;
    };

    let ticking = false;
    const scheduleUpdate = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        ticking = false;
        updateProgress();
      });
    };

    const cleanupController = new AbortController();
    updateProgress();
    window.addEventListener("scroll", scheduleUpdate, { passive: true, signal: cleanupController.signal });
    window.addEventListener("resize", scheduleUpdate, { signal: cleanupController.signal });
    window.addEventListener("pagehide", () => cleanupController.abort(), { once: true });
  }
</script>

<style>
  .reading-progress {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 3px;
    z-index: 1000;
    background: transparent;
  }

  .reading-progress__bar {
    width: 100%;
    height: 100%;
    background: var(--color-lavender-500);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 80ms linear;
  }
</style>
