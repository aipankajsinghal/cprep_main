<file path="src/components/RelatedPosts.astro">
---
import { getCollection } from "astro:content";

interface Props {
  currentSlug: string;
  cluster: string;
  tags: string[];
  limit?: number;
}

const { currentSlug, cluster, tags, limit = 3 } = Astro.props as Props;
const tagSet = new Set(tags);

const candidates = (await getCollection("blog", ({ data }) => !data.draft)).filter(
  (post) => post.slug !== currentSlug
);

const scored = candidates
  .map((post) => {
    let score = 0;
    if (post.data.cluster === cluster) score += 3;
    for (const tag of post.data.tags) {
      if (tagSet.has(tag)) score += 1;
    }
    return { post, score };
  })
  .sort((a, b) => {
    if (b.score !== a.score) return b.score - a.score;
    return b.post.data.date.getTime() - a.post.data.date.getTime();
  });

const selected: typeof scored = [];
for (const item of scored) {
  if (selected.length >= limit) break;
  if (item.score > 0) selected.push(item);
}
if (selected.length < limit) {
  for (const item of scored) {
    if (selected.length >= limit) break;
    if (!selected.some((picked) => picked.post.slug === item.post.slug)) {
      selected.push(item);
    }
  }
}
---
<section class="related-posts" aria-label="Related posts">
  <h2>Related Posts</h2>
  {selected.length === 0 ? (
    <p>No related posts yet.</p>
  ) : (
    <ul>
      {selected.map(({ post }) => (
        <li>
          <a href={`/blog/${post.slug}/`}>{post.data.title}</a>
        </li>
      ))}
    </ul>
  )}
</section>

<style>
  .related-posts {
    margin-top: 1.8rem;
  }

  .related-posts ul {
    padding-left: 1.1rem;
  }

  .related-posts a {
    text-decoration: none;
    transition: color 180ms ease;
  }
</style>
</file>

<file path="src/components/ShareButtons.astro">
---
interface Props {
  url: string;
  title: string;
  postSlug: string;
  cluster: string;
  instagramId?: string;
}

const {
  url,
  title,
  postSlug,
  cluster,
  instagramId = "champions.prep"
} = Astro.props as Props;

const encodedUrl = encodeURIComponent(url);
const encodedTitle = encodeURIComponent(title);
const whatsappHref = `https://wa.me/?text=${encodedTitle}%20${encodedUrl}`;
const xHref = `https://twitter.com/intent/tweet?text=${encodedTitle}&url=${encodedUrl}`;
const instagramHref = `https://www.instagram.com/${instagramId}/`;
---
<section class="share-buttons" aria-label="Share this article">
  <h2>Share</h2>
  <div class="share-buttons__row">
    <a href={whatsappHref} target="_blank" rel="noopener noreferrer" data-share-platform="whatsapp">
      WhatsApp
    </a>
    <a href={xHref} target="_blank" rel="noopener noreferrer" data-share-platform="x">
      X
    </a>
    <button type="button" data-share-platform="copy">Copy Link</button>
    <a href={instagramHref} target="_blank" rel="noopener noreferrer" data-share-platform="instagram">
      Instagram @{instagramId}
    </a>
  </div>
</section>

<script define:vars={{ url, postSlug, cluster }}>
  const shareRoot = document.querySelector(".share-buttons");
  if (shareRoot) {
    shareRoot.addEventListener("click", async (event) => {
      const target = event.target;
      if (!(target instanceof HTMLElement)) return;
      const el = target.closest("[data-share-platform]");
      if (!(el instanceof HTMLElement)) return;
      const platform = el.getAttribute("data-share-platform");
      if (!platform) return;

      if (platform === "copy") {
        try {
          await navigator.clipboard.writeText(url);
          el.textContent = "Copied";
          setTimeout(() => {
            el.textContent = "Copy Link";
          }, 1200);
        } catch {}
      }

      if (typeof window.cpTrack === "function") {
        window.cpTrack("share_click", {
          platform,
          post_slug: postSlug,
          cluster
        });
      }
    });
  }
</script>

<style>
  .share-buttons {
    margin-top: 1.5rem;
  }

  .share-buttons h2 {
    margin-bottom: 0.5rem;
    font-size: 1rem;
  }

  .share-buttons__row {
