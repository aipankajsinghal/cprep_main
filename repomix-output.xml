<file path="src/components/SmartCTA.astro">
---
interface Props {
  href?: string;
  cluster?: string;
  postSlug?: string;
  midLabel?: string;
  endLabel?: string;
}

const {
  href = "https://www.championsprep.in/",
  cluster = "",
  postSlug = "",
  midLabel = "Want structured guidance for this topic?",
  endLabel = "Liked this insight? Explore full study resources built for Class 11-12 Commerce.",
} = Astro.props as Props;
---

<!-- Mid-article CTA: inline, revealed at scroll 40% -->
<aside class="smart-cta smart-cta--mid" data-smart-cta-mid hidden aria-label="Mid-article call to action">
  <div class="smart-cta__rule" aria-hidden="true"></div>
  <div class="smart-cta__inner">
    <p class="smart-cta__eyebrow">ChampionsPrep</p>
    <p class="smart-cta__text">{midLabel}</p>
    <a href={href} data-smart-cta-link data-position="mid" class="smart-cta__link">
      Get a prep plan <span aria-hidden="true">→</span>
    </a>
  </div>
  <div class="smart-cta__rule" aria-hidden="true"></div>
</aside>

<!-- End-of-article CTA -->
<aside class="smart-cta smart-cta--end" aria-label="End of article call to action">
  <div class="smart-cta__inner">
    <p class="smart-cta__eyebrow">ChampionsPrep</p>
    <p class="smart-cta__headline">{endLabel}</p>
    <a href={href} data-smart-cta-link data-position="end" class="smart-cta__link smart-cta__link--end">
      Explore study resources <span aria-hidden="true">→</span>
    </a>
  </div>
</aside>

<script is:inline define:vars={{ postSlug, cluster }}>
  const mid = document.querySelector("[data-smart-cta-mid]");
  const postBody = document.querySelector(".post-body");

  if (mid instanceof HTMLElement && postBody instanceof HTMLElement) {
    if (getComputedStyle(postBody).position === "static") {
      postBody.style.position = "relative";
    }

    const marker = document.createElement("span");
    marker.setAttribute("aria-hidden", "true");
    marker.style.position = "absolute";
    marker.style.top = "40%";
    marker.style.left = "0";
    marker.style.width = "1px";
    marker.style.height = "1px";
    postBody.append(marker);

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          mid.hidden = false;
          observer.disconnect();
        }
      },
      { rootMargin: "0px 0px -15% 0px", threshold: 0 }
    );

    observer.observe(marker);
  }

  const ctaLinks = Array.from(document.querySelectorAll("[data-smart-cta-link]"));
  for (const link of ctaLinks) {
    if (!(link instanceof HTMLAnchorElement)) continue;
    link.addEventListener("click", () => {
      const position = link.getAttribute("data-position");
      if (!position) return;
      if (typeof window.cpTrack === "function") {
        window.cpTrack("cta_click", {
          post_slug: postSlug,
          cluster,
          position,
        });
      }
    });
  }
</script>

<style>
