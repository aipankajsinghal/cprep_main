<script>
  /**
   * Initialize an inline quiz with progressive enhancement.
   * - No-JS fallback: shows answer key in details element
   * - JS enhancement: adds interactivity, scoring, timer, feedback
   */
  function initQuiz(formElement: HTMLFormElement) {
    const quizDiv = formElement.closest(".inline-quiz") as HTMLElement;
    if (!quizDiv) return;

    const mode = quizDiv.dataset.mode as "practice" | "exam";
    const timeLimitStr = quizDiv.dataset.timeLimit;
    const timeLimit = timeLimitStr ? parseInt(timeLimitStr, 10) : null;
    const quizId = quizDiv.dataset.quizId;

    // DOM references
    const timerDisplay = formElement.querySelector("[data-timer-display]") as HTMLElement | null;
    const submitBtn = formElement.querySelector("[data-action='submit']") as HTMLButtonElement | null;
    const scoreValue = formElement.querySelector(".score-value") as HTMLElement | null;
    const scoreFeedback = formElement.querySelector(".quiz-feedback") as HTMLElement | null;
    const answerKeyNoJs = formElement.closest(".inline-quiz")?.querySelector(".answers-reveal-no-js") as HTMLDetailsElement | null;

    // State
    let timeRemaining = timeLimit;
    let timerActive = false;
    let submitted = false;
    let userSelections: (number | null)[] = [];

    const questions = Array.from(formElement.querySelectorAll(".quiz-question")) as HTMLElement[];
    userSelections = new Array(questions.length).fill(null);

    // Hide no-JS fallback once JS initializes
    if (answerKeyNoJs) {
      answerKeyNoJs.removeAttribute("hidden");
    }

    /**
     * Initialize and start the timer
     */
    const initTimer = () => {
      if (!timeLimit || !timerDisplay) return;

      const updateDisplay = () => {
        if (timeRemaining !== null) {
          const mins = Math.floor(timeRemaining / 60);
          const secs = timeRemaining % 60;
          timerDisplay.textContent = `${mins.toString().padStart(2, "0")}:${secs.toString().padStart(2, "0")}`;
        }
      };

      updateDisplay();

      let timerId: NodeJS.Timeout | null = null;

      const startTimer = () => {
        if (timerActive || submitted || timerId !== null) return;
        timerActive = true;

        timerId = setInterval(() => {
          if (timeRemaining === null) return;
          timeRemaining--;
          updateDisplay();

          if (timeRemaining <= 0) {
            if (timerId !== null) {
              clearInterval(timerId);
              timerId = null;
            }
            timerActive = false;
            if (mode === "exam") {
              submitQuiz();
            }
          }
        }, 1000);
      };

      // Cleanup on form removal or navigation
      const cleanup = () => {
        if (timerId !== null) {
          clearInterval(timerId);
          timerId = null;
        }
      };

      // Clean up timer when component is removed
      const observer = new MutationObserver(() => {
        if (!document.contains(formElement)) {
          cleanup();
          observer.disconnect();
        }
      });
      observer.observe(document.body, { childList: true, subtree: true });

      // Start timer on first user selection
      formElement.addEventListener(
        "change",
        () => {
          if (!timerActive && !submitted) {
            startTimer();
          }
        },
        { once: false }
      );
    };

    /**
     * Show feedback for a single answer (practice mode only)
     */
    const showFeedback = (questionIndex: number, selectedIndex: number) => {
      const fieldset = questions[questionIndex];
      if (!fieldset) return;

      const correctIndex = parseInt(fieldset.dataset.correctIndex || "-1", 10);
      const isCorrect = selectedIndex === correctIndex;

      // Get the selected option's feedback element
      const selectedInput = fieldset.querySelector(`input[value="${selectedIndex}"]`) as HTMLInputElement | null;
      if (!selectedInput) return;

      const container = selectedInput.parentElement;
      const feedback = container?.querySelector(".option-feedback") as HTMLElement | null;

      if (feedback) {
        feedback.classList.add("show");
        feedback.classList.toggle("correct", isCorrect);
        feedback.classList.toggle("incorrect", !isCorrect);
        feedback.textContent = isCorrect ? "✓ Correct!" : "✗ Incorrect";
      }

      // Auto-open explanation if correct (practice mode)
      if (isCorrect) {
        const explanation = fieldset.querySelector(".explanation-toggle") as HTMLDetailsElement | null;
        if (explanation) {
          explanation.open = true;
        }
      }
    };

    /**
     * Update the score display (practice mode only)
     */
    const updateScore = () => {
      if (!scoreValue || mode !== "practice") return;

      let score = 0;
      questions.forEach((fieldset, idx) => {
        const correctIndex = parseInt(fieldset.dataset.correctIndex || "-1", 10);
        if (userSelections[idx] === correctIndex) {
          score++;
        }
      });

      scoreValue.textContent = score.toString();
    };

    /**
     * Submit quiz (exam mode only)
     */
    const submitQuiz = () => {
      if (submitted) return;
      submitted = true;

      // Disable all inputs
      formElement.querySelectorAll("input").forEach((input) => {
        input.disabled = true;
      });

      if (submitBtn) {
        submitBtn.disabled = true;
      }

      // Calculate score and show results for all questions
      let score = 0;
      questions.forEach((fieldset, idx) => {
        const correctIndex = parseInt(fieldset.dataset.correctIndex || "-1", 10);
        const selectedIndex = userSelections[idx];
        const isCorrect = selectedIndex === correctIndex;

        if (isCorrect) {
          score++;
        }

        // Show feedback for each question
        fieldset.querySelectorAll("input").forEach((input) => {
          const optIndex = parseInt(input.value, 10);
          const container = input.parentElement;
          const feedback = container?.querySelector(".option-feedback") as HTMLElement | null;

          if (feedback) {
            feedback.classList.add("show");

            if (optIndex === correctIndex) {
              feedback.classList.add("correct");
              feedback.textContent = "✓ Correct answer";
              const label = container?.querySelector("label") as HTMLElement | null;
              if (label) {
                label.style.fontWeight = "600";
              }
            } else if (input.checked) {
              feedback.classList.add("incorrect");
              feedback.textContent = "✗ Your answer";
            }
          }
        });

        // Open all explanations
        const explanation = fieldset.querySelector(".explanation-toggle") as HTMLDetailsElement | null;
        if (explanation) {
          explanation.open = true;
        }
      });

      // Show score feedback
      if (scoreFeedback) {
        scoreFeedback.classList.add("show");
        const percentage = Math.round((score / questions.length) * 100);
        const resultDiv = document.createElement("div");
        resultDiv.innerHTML = `<strong>Quiz Complete!</strong><br>You scored <strong>${score} out of ${questions.length}</strong> (${percentage}%)`;
        scoreFeedback.replaceChildren(resultDiv);
      }

      // Send analytics
      if (typeof window !== "undefined" && window.cpTrack) {
        const timeTaken = timeLimit ? timeLimit - (timeRemaining || 0) : 0;
        window.cpTrack("quiz_completed", {
          quizId,
          mode,
          score,
          total: questions.length,
          timeTaken,
        });
      }
    };

    // Event listeners
    formElement.addEventListener("change", (e) => {
      const input = e.target as HTMLInputElement;
      if (input.type === "radio" && input.classList.contains("option-input")) {
        const questionIndex = parseInt(input.name.replace("question-", ""), 10);
        const selectedIndex = parseInt(input.value, 10);

        // Defensive: validate indices are in bounds
        if (questionIndex < 0 || questionIndex >= questions.length) return;
        const fieldset = questions[questionIndex];
        const correctIndex = parseInt(fieldset.dataset.correctIndex || "-1", 10);
        if (selectedIndex < 0 || selectedIndex >= (fieldset.querySelector(".options-group")?.children.length || 0)) return;

        userSelections[questionIndex] = selectedIndex;

        if (mode === "practice") {
          showFeedback(questionIndex, selectedIndex);
          updateScore();
        } else if (mode === "exam" && submitBtn) {
          // Enable submit button once at least one answer is given
          submitBtn.disabled = false;
        }
      }
    });

    if (submitBtn && mode === "exam") {
      submitBtn.addEventListener("click", (e) => {
        e.preventDefault();
        submitQuiz();
      });
    }

    // Initialize timer if present
    initTimer();
  }

  // Initialize all quizzes on page load
  if (typeof document !== "undefined") {
    const initializeQuizzes = () => {
      document.querySelectorAll(".quiz-form").forEach((form) => {
        if (form instanceof HTMLFormElement) {
          initQuiz(form);
        }
      });
    };

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initializeQuizzes);
    } else {
      initializeQuizzes();
    }
  }
</script>
</file>

