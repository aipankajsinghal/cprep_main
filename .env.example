# ─── Sanity CMS ────────────────────────────────────────────────────────────────
# Get these from https://sanity.io/manage → your project → API
SANITY_PROJECT_ID=your_project_id_here
SANITY_DATASET=production
SANITY_API_VERSION=2024-01-01
# Read token – required for preview / unpublished content; leave blank for public CDN reads
SANITY_API_TOKEN=

# ─── Sanity Studio (used by studio/sanity.config.ts) ───────────────────────────
# These mirror the values above and are prefixed SANITY_STUDIO_ so they are
# available in the studio/ Vite process (Sanity Studio uses its own Vite build).
SANITY_STUDIO_PROJECT_ID=your_project_id_here
SANITY_STUDIO_DATASET=production

# ─── AI features (optional) ────────────────────────────────────────────────────
# For Sanity Studio AI Assistant (SEO descriptions and quiz generation)
# GOOGLE_GENERATIVE_AI_API_KEY=your-gemini-api-key-here
# Also set SANITY_STUDIO_SITE_URL to enable Studio AI features:
# SANITY_STUDIO_SITE_URL=http://localhost:4321

# ─── Deployment ─────────────────────────────────────────────────────────────────
# VERCEL_TOKEN=
